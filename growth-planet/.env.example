# 成长星球 · 后端环境变量示例（复制为部署环境变量使用，勿提交真实密钥）
#
# 说明：本项目所有敏感配置均经环境变量注入，代码库内不写死任何密钥。
# 下列变量为「七牛云对象存储（Kodo）」相关配置。

# ===== 七牛云对象存储（Kodo）=====
# 三个必需项：必须同时提供，否则启动即失败（部分配置视为误配）；
# 三者全部留空表示未启用对象存储 —— 上传凭证接口降级返回 E-503，不影响应用启动。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# 可选（有默认值，一般无需覆盖）
# 资源读取域名（图片/视频同域，以 img/ 与 video/ 路径前缀区分）
QINIU_IMAGE_DOMAIN=image.studykid.cn
# 上传入口（按 bucket 机房选择：z1/z2/na0/as0 等）
QINIU_UPLOAD_HOST=https://upload.qiniup.com
# 上传凭证有效期（秒），默认 3600
QINIU_TOKEN_TTL=3600

# ===== JWT（后台运营端与 C 端密钥必须隔离）=====
JWT_SECRET=
JWT_ADMIN_SECRET=

# ===== 后台运营端首个超管引导账号（仅当 sys_admin_user 为空时播种）=====
CONSOLE_BOOTSTRAP_USERNAME=admin.zhou
CONSOLE_BOOTSTRAP_PASSWORD=
CONSOLE_BOOTSTRAP_NAME=超级管理员

# ===== 微信（小程序 / 公众号）=====
WX_APPID=
WX_SECRET=
