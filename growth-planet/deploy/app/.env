# 成长星球 · 后端部署环境变量（由 start.sh 加载；Spring Boot 通过 ${VAR} 自动绑定）
# 说明：以下变量 application.yml 已支持外部化（改动即生效）。
# 复制本文件为 .env 并填入真实值；不要提交真实密钥到代码库。

# ===== JWT（运营端与 C 端密钥必须隔离，填强随机值）=====
JWT_SECRET=
JWT_ADMIN_SECRET=

# ===== 七牛云对象存储（Kodo，三者全空=未启用，上传接口降级 E-503）=====
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=studykid
QINIU_IMAGE_DOMAIN=image.studykid.cn
QINIU_UPLOAD_HOST=https://upload.qiniup.com
QINIU_TOKEN_TTL=3600

# ===== 后台运营端首个超管引导账号（仅当 sys_admin_user 为空时播种）=====
CONSOLE_BOOTSTRAP_USERNAME=admin.zhou
CONSOLE_BOOTSTRAP_PASSWORD=
CONSOLE_BOOTSTRAP_NAME=超级管理员

# ===== 微信（小程序 / 公众号）=====
WX_APPID=
WX_SECRET=

# ===== 数据库 / Redis 连接 =====
# ⚠️ 注意：当前 application.yml 仍硬编码 root/root + localhost，
#    下列变量暂不会生效，需先把数据源外部化为 ${DB_*} / ${REDIS_*} 后方可启用。
#    在外部化完成前，应用会尝试用 root/root 连本机 MySQL（与已建账号不符，会启动失败）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=growth_planet
DB_USER=growthplanet
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 服务运行参数（可选覆盖）=====
# APP_PORT=19100
# APP_PROFILE=dev
# JVM_HEAP=320m
# JVM_META=96m
# JVM_DIRECT=64m
