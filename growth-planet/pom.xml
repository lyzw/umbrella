<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>cn.studykid.growthplanet</groupId>
    <artifactId>sk-growthplanet</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sk-growthplanet</name>
    <description>成长星球后端多模块聚合父 POM（core / miniapp / admin / start）</description>

    <modules>
        <module>sk-growthplanet-core</module>
        <module>sk-growthplanet-miniapp</module>
        <module>sk-growthplanet-admin</module>
        <module>sk-growthplanet-start</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jjwt.version>0.12.7</jjwt.version>
        <qiniu.version>7.19.0</qiniu.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <jackson2.version>2.21.5</jackson2.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>cn.studykid.growthplanet</groupId>
                <artifactId>sk-growthplanet-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.studykid.growthplanet</groupId>
                <artifactId>sk-growthplanet-miniapp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.studykid.growthplanet</groupId>
                <artifactId>sk-growthplanet-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus JacksonTypeHandler（实体 JSON 字段）依赖 Jackson 2（SB4 默认仅提供 Jackson 3） -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <!-- 默认 test 作用域仅执行纯逻辑单元测试，集成测试（*IT / LogicDeleteTest）置于 start 模块 integration profile -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                            <exclude>**/LogicDeleteTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
