.wallet-page { min-height: 100vh; }
.child-picker { margin-bottom: 12px; }
.wallet-tabs { position: sticky; top: 0; z-index: 3; margin: 12px 0 16px; }
.balance-card {
  background: var(--primary-soft);
  border: 1px solid var(--primary-border);
  border-radius: var(--radius-lg);
  padding: 20px;
  margin-bottom: 14px;
  box-shadow: var(--shadow-soft);
}
.balance-card .amount { font-size: 36px; }
.balance-card .row { margin-top: 10px; }
.board-card { background: var(--primary-soft); border-color: var(--primary-border); }
.section {
  border-top: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: var(--shadow-soft);
}
.section + .section { margin-top: 4px; }
.section button.primary, .query-button { width: 100%; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.section-heading .section-title { margin-bottom: 0; }
.section-subtitle { margin: 18px 0 8px; color: #344054; font-size: 14px; font-weight: 800; }
.children-title { margin-top: 20px; }
.range-chips { flex-wrap: nowrap; margin: 0; }
.range-chips .chip { margin-right: 0; margin-left: 6px; }
.stats-tabs { margin-top: 14px; }
.item .row { align-items: baseline; }
.price.income { color: var(--positive); }
.chips { display: flex; flex-wrap: wrap; margin: 4px 0 10px; }
.chart-canvas { width: 100%; height: 100%; }
.date-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.rule-usage { margin-bottom: 16px; }

@media (max-width: 420px) {
  .section-heading { align-items: flex-start; flex-direction: column; }
  .range-chips .chip { margin-left: 0; margin-right: 8px; }
  .date-grid { grid-template-columns: 1fr; gap: 0; }
}
