<view class="page parent dish-manage-page {{showForm ? 'has-form-actions' : ''}}">
  <page-back role="{{role}}" fallback-tab="home" disabled="{{busy}}" />
  <view class="header">
    <view>
      <view class="eyebrow">仅当前家庭可见</view>
      <view class="title">{{showForm ? (isEdit ? '编辑菜品' : '新增菜品') : '我的菜品'}}</view>
    </view>
    <button wx:if="{{!showForm}}" class="primary" bindtap="create" disabled="{{busy}}">新增</button>
  </view>
  <view wx:if="{{!showForm}}" class="notice">这里录入的菜品属于当前家庭私有，可用于家庭菜单编排，其他家庭不可见。</view>

  <block wx:if="{{!showForm}}">
    <view class="filter-row">
      <picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="filter" disabled="{{busy}}">
        <view class="picker status-picker">{{statusOptions[statusIndex]}}⌄</view>
      </picker>
      <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="search" placeholder="搜索我的菜品" maxlength="64" disabled="{{busy}}" /></view>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{busy && !ready}}" class="loading">正在加载我的菜品…</view>
    <view wx:if="{{ready && !dishes.length}}" class="empty">
      <view class="empty-icon">🍳</view>
      <view class="section-title">还没有菜品</view>
      <view class="muted">点右上角「新增」录入第一道家庭菜品吧。</view>
    </view>
    <view wx:for="{{dishes}}" wx:key="dishId" class="item dish-card">
      <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="dish-thumb" binderror="imageError" data-id="{{item.dishId}}" />
      <view wx:else class="dish-thumb fallback"><text class="fallback-icon">🍲</text></view>
      <view class="dish-body">
        <view class="section-title">{{item.name}}</view>
        <view>
          <text class="badge {{item.status === 'ON_SALE' ? 'safe' : 'warning'}}">{{item.statusLabel}}</text>
          <text class="badge">{{item.spiceLabel}}</text>
        </view>
        <view class="small">{{item.allergenLabel}}</view>
        <view class="small recipe-line">配方：{{item.recipeSummary}}{{item.difficultyLabel ? ' · ' + item.difficultyLabel : ''}}</view>
        <view class="price">{{item.virtualPrice}} <text class="small">虚拟单位 / 份</text></view>
        <view class="dish-actions">
          <button bindtap="edit" data-id="{{item.dishId}}" disabled="{{busy}}">编辑</button>
          <button bindtap="toggleStatus" data-id="{{item.dishId}}" disabled="{{busy}}">{{item.toggleLabel}}</button>
          <button class="danger" bindtap="remove" data-id="{{item.dishId}}" disabled="{{busy}}">删除</button>
        </view>
      </view>
    </view>
    <view wx:if="{{ready && total > pageSize}}" class="pager">
      <button bindtap="prev" disabled="{{busy || !hasPrev}}">上一页</button>
      <text class="small">第 {{page}} 页 · 共 {{total}} 条</text>
      <button bindtap="nextPage" disabled="{{busy || !hasNext}}">下一页</button>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="form-section">
      <view class="form-section-heading"><view class="step-number">1</view><view><view class="section-title">基础信息</view><view class="small">用于家庭菜单中识别和计价</view></view></view>
      <view class="field">
        <view class="label">菜品名称</view>
        <input value="{{formName}}" data-field="formName" bindinput="input" maxlength="64" placeholder="如：番茄炒蛋" disabled="{{busy}}" />
      </view>
      <view class="field">
        <view class="label">分类</view>
        <picker range="{{categoryNames}}" value="{{formCategoryIndex}}" bindchange="pickCategory" disabled="{{busy}}">
          <view class="picker">{{formCategoryIndex >= 0 ? categoryNames[formCategoryIndex] : '请选择分类'}}⌄</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">所需虚拟单位</view>
        <input type="digit" value="{{formVirtualPrice}}" data-field="formVirtualPrice" bindinput="input" maxlength="11" placeholder="如 8.00" disabled="{{busy}}" />
      </view>
      <view class="field">
        <view class="label">图片地址（选填）</view>
        <input value="{{formImageUrl}}" bindinput="imageUrlInput" maxlength="255" placeholder="请输入 HTTPS 图片链接" disabled="{{busy}}" />
        <view class="small field-help">当前由服务端保存图片链接，仅支持 HTTPS 地址。</view>
        <view wx:if="{{formImageUrl}}" class="image-preview">
          <image wx:if="{{!formImageError}}" src="{{formImageUrl}}" mode="aspectFill" binderror="imageError" data-target="form" />
          <view wx:else class="image-preview-error">图片无法加载，请检查地址</view>
          <button bindtap="clearImage" disabled="{{busy}}">清除图片</button>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-section-heading"><view class="step-number">2</view><view><view class="section-title">营养与口味</view><view class="small">帮助孩子和家长更快筛选</view></view></view>
      <view class="field">
        <view class="label">卡路里（选填，kcal）</view>
        <input type="number" value="{{formCalories}}" data-field="formCalories" bindinput="input" maxlength="5" placeholder="如 220" disabled="{{busy}}" />
      </view>
      <view class="field">
        <view class="label">辣度</view>
        <picker range="{{spiceOptions}}" value="{{formSpiceIndex}}" bindchange="pickSpice" disabled="{{busy}}">
          <view class="picker">{{spiceOptions[formSpiceIndex]}}⌄</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">标签（选填，最多 5 项）</view>
        <input value="{{formTagsText}}" data-field="formTagsText" bindinput="input" maxlength="120" placeholder="如：家常、快手" disabled="{{busy}}" />
        <view class="small field-help">支持逗号、中文逗号或换行分隔。</view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-section-heading"><view class="step-number">3</view><view><view class="section-title">食材与做法（选填）</view><view class="small">供孩子与家长查看，不填也能保存与上架</view></view></view>
      <view wx:if="{{formRecipeNotice}}" class="recipe-notice">{{formRecipeNotice}}</view>
      <view class="field">
        <view class="label">食材（最多 {{maxIngredients}} 条）</view>
        <view wx:for="{{formIngredients}}" wx:key="key" class="recipe-row">
          <view class="recipe-row-head">
            <text class="recipe-row-index">{{index + 1}}</text>
            <view class="recipe-row-tools">
              <button class="row-action" data-index="{{index}}" data-delta="-1" bindtap="moveIngredient" disabled="{{busy || index === 0}}">上移</button>
              <button class="row-action" data-index="{{index}}" data-delta="1" bindtap="moveIngredient" disabled="{{busy || index === formIngredients.length - 1}}">下移</button>
              <button class="row-action danger" data-index="{{index}}" bindtap="removeIngredient" disabled="{{busy}}">删除</button>
            </view>
          </view>
          <view class="recipe-row-fields">
            <input value="{{item.name}}" data-field="formIngredients[{{index}}].name" bindinput="input" maxlength="32" placeholder="食材名称，如 番茄" disabled="{{busy}}" />
            <input value="{{item.amount}}" data-field="formIngredients[{{index}}].amount" bindinput="input" maxlength="32" placeholder="用量，如 2 个" disabled="{{busy}}" />
          </view>
        </view>
        <button class="add-row" bindtap="addIngredient" disabled="{{busy || formIngredients.length >= maxIngredients}}">+ 添加食材</button>
        <view class="small field-help">只填名称也可保存；整行留空时保存会自动忽略，无需手动删干净。</view>
      </view>

      <view class="field">
        <view class="label">做法步骤（最多 {{maxSteps}} 步）</view>
        <view wx:for="{{formCookSteps}}" wx:key="key" class="recipe-row">
          <view class="recipe-row-head">
            <text class="recipe-row-index">{{index + 1}}</text>
            <view class="recipe-row-tools">
              <button class="row-action" data-index="{{index}}" data-delta="-1" bindtap="moveStep" disabled="{{busy || index === 0}}">上移</button>
              <button class="row-action" data-index="{{index}}" data-delta="1" bindtap="moveStep" disabled="{{busy || index === formCookSteps.length - 1}}">下移</button>
              <button class="row-action danger" data-index="{{index}}" bindtap="removeStep" disabled="{{busy}}">删除</button>
            </view>
          </view>
          <textarea value="{{item.text}}" data-field="formCookSteps[{{index}}].text" bindinput="input" maxlength="300" placeholder="描述这一步怎么做" disabled="{{busy}}" auto-height />
        </view>
        <button class="add-row" bindtap="addStep" disabled="{{busy || formCookSteps.length >= maxSteps}}">+ 添加步骤</button>
        <view class="small field-help">步骤按当前顺序保存，孩子看到的也是这个顺序。</view>
      </view>

      <view class="field">
        <view class="label">小贴士（选填）</view>
        <textarea value="{{formCookTips}}" data-field="formCookTips" bindinput="input" maxlength="500" placeholder="如：给孩子吃可减少辣椒用量" disabled="{{busy}}" auto-height />
      </view>

      <view class="field">
        <view class="label">烹饪时长（分钟，选填）</view>
        <input type="number" value="{{formCookMinutes}}" data-field="formCookMinutes" bindinput="input" maxlength="4" placeholder="如 25" disabled="{{busy}}" />
      </view>
      <view class="field">
        <view class="label">份量（人份，选填）</view>
        <input type="number" value="{{formServings}}" data-field="formServings" bindinput="input" maxlength="2" placeholder="如 3" disabled="{{busy}}" />
      </view>
      <view class="field">
        <view class="label">难度（选填）</view>
        <picker range="{{difficultyOptions}}" value="{{formDifficultyIndex}}" bindchange="pickDifficulty" disabled="{{busy}}">
          <view class="picker">{{difficultyOptions[formDifficultyIndex]}}⌄</view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="form-section-heading"><view class="step-number">4</view><view><view class="section-title">安全信息</view><view class="small">过敏信息会直接影响儿童是否可点选</view></view></view>
      <view class="field">
        <view class="label">过敏原</view>
        <checkbox-group class="allergen-grid" bindchange="allergens">
          <label wx:for="{{allergenOptions}}" wx:key="code" class="check allergen-option">
            <checkbox value="{{item.code}}" checked="{{item.checked}}" disabled="{{busy}}" />
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
      </view>
      <view class="field">
        <view class="label">过敏原状态</view>
        <picker range="{{allergenStatusOptions}}" value="{{formAllergenIndex}}" bindchange="pickAllergenStatus" disabled="{{busy}}">
          <view class="picker">{{allergenStatusOptions[formAllergenIndex]}}⌄</view>
        </picker>
        <view class="small field-help">状态为「待确认」时儿童无法点选；核对完成后再设为「已声明」。</view>
      </view>
    </view>
    <view class="form-actions">
      <button bindtap="closeForm" disabled="{{busy}}">取消</button>
      <button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存菜品</button>
    </view>
  </block>
</view>
