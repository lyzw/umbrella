.dish-manage-page { padding-bottom: 56px; }
.dish-manage-page.has-form-actions { padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
.filter-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.status-picker { width: 118px; min-width: 118px; min-height: 48px; text-align: center; font-weight: 600; }
.search-box { flex: 1; min-width: 0; position: relative; }
.search-box input { padding-left: 40px; }
.search-icon { position: absolute; left: 14px; top: 0; z-index: 1; color: #687386; font-size: 20px; line-height: 48px; }
.dish-card { display: flex; align-items: flex-start; gap: 14px; }
.dish-thumb { width: 96px; height: 96px; flex: 0 0 96px; border-radius: var(--radius-md); }
.dish-thumb.fallback { background: #eef3fb; display: flex; align-items: center; justify-content: center; color: #687386; }
.dish-thumb .fallback-icon { font-size: 30px; }
.dish-body { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.dish-body .section-title { margin-bottom: 4px; font-size: 17px; }
.dish-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.dish-actions button { flex: 1; min-width: 84px; }
.empty-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 30px; background: var(--primary-soft); color: var(--primary); }
.pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 16px; }
.pager button { min-width: 96px; }
.form-section { padding: 4px 0 22px; margin-bottom: 22px; border-bottom: 1px solid var(--line); }
.form-section:last-of-type { border-bottom: 0; }
.form-section-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.form-section-heading .section-title { margin-bottom: 2px; }
.step-number {
  width: 32px;
  min-width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 14px;
  line-height: 32px;
  text-align: center;
  font-weight: 800;
}
.field-help { margin-top: 7px; }
.image-preview { display: grid; grid-template-columns: 96px 1fr; align-items: center; gap: 12px; margin-top: 12px; }
.image-preview image,
.image-preview-error { width: 96px; height: 72px; border-radius: var(--radius-sm); }
.image-preview-error {
  display: flex;
  align-items: center;
  padding: 8px;
  background: var(--danger-soft);
  color: #9d241b;
  font-size: 12px;
  line-height: 1.4;
}
.image-preview button { justify-self: start; }
.allergen-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.allergen-option { padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
.recipe-line { color: var(--muted); }
.recipe-notice {
  margin-bottom: 18px;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  background: var(--danger-soft);
  color: #9d241b;
  font-size: 13px;
  line-height: 1.5;
}
.recipe-row { margin-bottom: 12px; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
.recipe-row-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
.recipe-row-index {
  width: 24px;
  min-width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 12px;
  line-height: 24px;
  text-align: center;
  font-weight: 800;
}
.recipe-row-tools { display: flex; gap: 6px; }
/* 行内小按钮：覆盖全局 button 的块级尺寸，避免一排按钮把卡片撑散。 */
button.row-action {
  width: auto;
  min-width: 54px;
  min-height: 0;
  margin: 0;
  padding: 5px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.4;
  background: var(--surface-2);
  color: #344054;
  box-shadow: none;
}
button.row-action.danger { background: #fff0f0; color: #b42318; }
.recipe-row-fields { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 8px; }
.recipe-row-fields input { min-height: 44px; }
.recipe-row textarea { width: 100%; min-height: 62px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); font-size: 14px; line-height: 1.5; }
.add-row { width: 100%; min-height: 44px; margin-top: 2px; background: var(--surface); border: 1px dashed var(--line); color: var(--primary); font-weight: 700; box-shadow: none; }
.form-actions {
  position: fixed;
  z-index: 12;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: minmax(100px, .7fr) minmax(180px, 1.3fr);
  gap: 10px;
  padding: 10px max(18px, calc((100vw - 760px) / 2 + 18px)) calc(10px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 -8px 24px rgba(32, 55, 92, .08);
}
@media (max-width: 340px) {
  .allergen-grid { grid-template-columns: 1fr; }
  .form-actions { padding-left: 12px; padding-right: 12px; }
}
