.dish-manage-page { padding-bottom: 56px; }
.filter-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.status-picker { width: 118px; min-width: 118px; min-height: 48px; text-align: center; font-weight: 600; }
.search-box { flex: 1; min-width: 0; position: relative; }
.search-box input { padding-left: 40px; }
.search-icon { position: absolute; left: 14px; top: 0; z-index: 1; color: #687386; font-size: 20px; line-height: 48px; }
.dish-card { display: flex; align-items: flex-start; gap: 14px; }
.dish-thumb { width: 96px; height: 96px; flex: 0 0 96px; border-radius: var(--radius-md); }
.dish-thumb.fallback { background: #eef3fb; display: flex; align-items: center; justify-content: center; color: #687386; }
.dish-thumb .fallback-icon { font-size: 30px; }
.dish-body { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.dish-body .section-title { margin-bottom: 4px; font-size: 17px; }
.dish-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.dish-actions button { flex: 1; min-width: 84px; }
.empty-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 30px; background: var(--primary-soft); color: var(--primary); }
.pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 16px; }
.pager button { min-width: 96px; }
