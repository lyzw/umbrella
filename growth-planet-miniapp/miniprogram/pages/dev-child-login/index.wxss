.dev-page { min-height: 100vh; padding: 24px 18px 40px; }
.head { margin-bottom: 18px; }
.head .title { font-size: 21px; font-weight: 800; color: #172033; }
.head .sub { margin-top: 6px; font-size: 12px; color: var(--muted); line-height: 1.5; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 16px; margin-bottom: 14px; box-shadow: var(--shadow-soft); }
.card .step { font-size: 14px; font-weight: 800; color: #172033; margin-bottom: 12px; }
.field { margin-bottom: 12px; }
.field .label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
.field input { height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); font-size: 15px; background: var(--surface-2); }
.card .primary { width: 100%; background: var(--primary); color: #fff; border-radius: var(--radius-sm); }
.card .primary[disabled] { background: var(--primary-border); color: #fff; }
.combo { width: 100%; margin-top: 4px; background: var(--positive); color: #fff; border-radius: var(--radius-sm); }
.combo[disabled] { background: var(--positive-soft); color: #fff; }
.ok { margin-top: 14px; padding: 12px 14px; background: var(--positive-soft); border: 1px solid var(--positive); border-radius: var(--radius-sm); color: var(--positive-ink); font-size: 13px; }
.error { margin-top: 14px; padding: 10px 14px; color: var(--danger); font-size: 13px; }
