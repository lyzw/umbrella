.page { min-height: 100vh; background: #f7f9fc; padding: 22rpx 22rpx 160rpx; box-sizing: border-box; }
.head { padding: 12rpx 8rpx 4rpx; }
.title { font-size: 38rpx; font-weight: 700; color: #1f2d3d; }
.sub { display: block; font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }

.toast { margin: 14rpx 8rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #e8f3ff; color: #2878ff; font-size: 26rpx; }
.toast.err { background: #ffece8; color: #ff7657; }

.bar { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 8rpx; }
.picker { padding: 14rpx 20rpx; background: #fff; border-radius: 14rpx; font-size: 26rpx; color: #1f2d3d; box-shadow: 0 2rpx 8rpx rgba(31,45,61,.06); }

.card { background: #fff; border-radius: 18rpx; padding: 22rpx; margin: 12rpx 8rpx; box-shadow: 0 2rpx 10rpx rgba(31,45,61,.06); }
.form .input { margin-bottom: 14rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.row2 { display: flex; gap: 14rpx; margin-bottom: 14rpx; }
.row2 .input { flex: 1; }
.input { background: #f3f6fb; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #1f2d3d; }
.input.center { display: flex; align-items: center; }

.sec-title { font-size: 28rpx; font-weight: 600; color: #1f2d3d; margin: 22rpx 8rpx 4rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #1f2d3d; }
.muted { font-size: 24rpx; color: #8a94a6; margin-top: 8rpx; }
.empty { text-align: center; color: #8a94a6; font-size: 26rpx; padding: 40rpx 0; }

.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.badge.normal { background: #eef1f6; color: #8a94a6; }
.badge.warn { background: #fff2e8; color: #ff7657; }
.badge.ok { background: #e7f6ee; color: #15966a; }
.badge.err { background: #ffece8; color: #ff7657; }
.badge.earn { background: #e8f3ff; color: #2878ff; font-weight: 600; }

.actions { display: flex; gap: 14rpx; margin-top: 16rpx; }

.btn { border: none; border-radius: 14rpx; font-size: 28rpx; padding: 18rpx 28rpx; background: #2878ff; color: #fff; }
.btn.sm { padding: 12rpx 22rpx; font-size: 26rpx; }
.btn-primary { background: #2878ff; color: #fff; }
.btn-ghost { background: #eef1f6; color: #5a6677; }
