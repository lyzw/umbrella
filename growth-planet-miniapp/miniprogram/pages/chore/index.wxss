.page-heading { margin-bottom: 18px; }
.page-heading .subtitle { display: block; margin-bottom: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.compact-picker { min-width: 150px; }
.compact-action { flex: 0 0 auto; }
.form-panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-bottom: 22px;
  box-shadow: var(--shadow-soft);
}
.form-panel > input { margin-bottom: 12px; }
.form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(120px, .7fr); gap: 12px; }
.form-row picker { min-width: 0; }
.form-submit { width: 100%; margin-top: 12px; }
.list-title { margin-top: 24px; }
.item-title { min-width: 0; font-size: 16px; font-weight: 800; line-height: 1.45; overflow-wrap: anywhere; }
.item-action { margin-top: 16px; }
.badge.normal { color: var(--muted); background: var(--surface-2); }
.badge.warn { color: #a45a00; background: var(--warning-soft); }
.badge.ok { color: #08764e; background: var(--positive-soft); }
.badge.err { color: #9d241b; background: var(--danger-soft); }
.badge.earn { color: var(--primary-ink); background: var(--primary-soft); }

@media (max-width: 420px) {
  .toolbar { align-items: stretch; flex-direction: column; }
  .compact-picker, .compact-action { width: 100%; }
  .form-row { grid-template-columns: 1fr; }
}
