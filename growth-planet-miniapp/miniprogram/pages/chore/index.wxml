<view class="page {{role === 'PARENT' ? 'parent' : 'with-nav'}}">
  <page-back wx:if="{{role === 'PARENT'}}" role="{{role}}" fallback-tab="home" disabled="{{busy}}" />
  <view class="page-heading">
    <text class="title">家务小当家</text>
    <text class="subtitle">认领任务 · 完成赚取虚拟单位 · 解锁勋章</text>
  </view>

  <view wx:if="{{receipt}}" class="notice">{{receipt}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{role === 'PARENT'}}">
    <view wx:if="{{children.length}}" class="toolbar">
      <picker mode="selector" range="{{children}}" range-key="nickname" bindchange="child">
        <view class="picker compact-picker">{{children[childIndex].nickname || '儿童 ' + children[childIndex].childId}}</view>
      </picker>
      <button class="primary compact-action" bindtap="toggleForm">{{showForm ? '收起' : '添加任务'}}</button>
    </view>

    <view wx:if="{{showForm}}" class="form-panel">
      <input placeholder="任务名称（1-64字）" value="{{title}}" bindinput="onTitle" maxlength="64" />
      <view class="form-row">
        <input placeholder="奖励（虚拟单位）" value="{{reward}}" bindinput="onReward" />
        <picker mode="selector" range="{{cycleLabels}}" value="{{cycleIndex}}" bindchange="cycle">
          <view class="picker">{{cycleLabels[cycleIndex]}}</view>
        </picker>
      </view>
      <button class="primary form-submit" bindtap="createTask">创建任务</button>
    </view>

    <view class="section-title list-title">待确认（{{instances.length}}）</view>
    <view wx:for="{{instances}}" wx:key="instanceId" class="item">
      <view class="row">
        <text class="item-title">{{item.taskTitle}}</text>
        <text class="badge {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
      <view class="muted">奖励 {{item.rewardAmount}} · 认领日 {{item.claimDate}}</view>
      <view class="actions">
        <button class="primary" data-id="{{item.instanceId}}" data-version="{{item.version}}" bindtap="confirm">确认完成</button>
        <button data-id="{{item.instanceId}}" data-version="{{item.version}}" bindtap="reject">驳回</button>
      </view>
    </view>
    <view wx:if="{{instances.length === 0}}" class="empty">暂无待确认的家务</view>
  </block>

  <block wx:else>
    <view class="section-title list-title">任务库</view>
    <view wx:for="{{tasks}}" wx:key="taskId" class="item">
      <view class="row">
        <text class="item-title">{{item.icon}} {{item.title}}</text>
        <text class="badge earn">+{{item.rewardAmount}}</text>
      </view>
      <view class="muted">{{item.description || '认真完成就能赚到奖励'}} · {{item.cycleLabel}}</view>
      <button class="primary item-action" data-id="{{item.taskId}}" bindtap="claim">认领</button>
    </view>
    <view wx:if="{{tasks.length === 0}}" class="empty">家长还没有发布家务任务</view>

    <view class="section-title list-title">我的家务</view>
    <view wx:for="{{instances}}" wx:key="instanceId" class="item">
      <view class="row">
        <text class="item-title">{{item.taskTitle}}</text>
        <text class="badge {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
      <view class="muted">奖励 {{item.rewardAmount}} · {{item.claimDate}}</view>
      <view class="actions" wx:if="{{item.status === 'CLAIMED'}}">
        <button class="primary" data-id="{{item.instanceId}}" bindtap="submit">提交完成</button>
      </view>
      <view class="muted" wx:if="{{item.status === 'REJECTED'}}">驳回原因：{{item.rejectReason || '无'}}</view>
    </view>
    <view wx:if="{{instances.length === 0}}" class="empty">还没有认领家务，去上面挑一个吧</view>

    <view class="section-title list-title">今日健康打卡</view>
    <view wx:for="{{checkItems}}" wx:key="key" class="item">
      <view class="row">
        <text class="item-title">{{item.icon}} {{item.name}}</text>
        <text class="badge {{item.reached ? 'ok' : 'normal'}}">{{item.limitText}}</text>
      </view>
      <view class="muted">今日 {{item.targetText}}</view>
      <button class="primary item-action" data-id="{{item.itemId}}" bindtap="checkIn" disabled="{{item.reached}}">{{item.actionLabel}}</button>
    </view>
    <view wx:if="{{checkItems.length === 0}}" class="empty">家里还没有打卡项，请家长到「健康打卡」添加</view>
    <view wx:if="{{streak}}" class="streak-card">
      <view class="streak-copy">
        <text class="streak-label">连续打卡</text>
        <text class="streak-value">{{streak}}<text class="streak-unit">天</text></text>
      </view>
      <view class="streak-visual" aria-hidden="true">🔥</view>
    </view>
    <button class="ghost item-action task-health-link" bindtap="go" data-page="health">查看打卡日历</button>
  </block>

  <app-nav wx:if="{{role === 'CHILD'}}" role="{{role}}" active="{{active}}" bindchange="changeTab" />
</view>
