<view class="page menu-page {{role === 'PARENT' ? 'parent' : ''}}">
  <page-back role="{{role}}" fallback-tab="{{role === 'CHILD' ? 'meal' : 'home'}}" disabled="{{busy}}" />
  <view class="header menu-header">
    <view><view class="eyebrow">{{role === 'PARENT' ? '仅当前家庭有效' : '小当家 · 点餐'}}</view><view class="title">{{role === 'PARENT' ? '家庭菜单维护' : '今日餐单'}}</view></view>
    <picker mode="date" value="{{menuDate}}" bindchange="date" disabled="{{busy}}"><view class="picker date-picker">{{menuDate}}</view></picker>
  </view>
  <scroll-view wx:if="{{week.length}}" class="week-strip" scroll-x="true" enable-flex="true">
    <view wx:for="{{week}}" wx:key="date" class="week-day {{item.active ? 'active' : ''}} {{item.isToday ? 'today' : ''}}" bindtap="weekDay" data-date="{{item.date}}">
      <text class="week-day-label">{{item.label}}</text>
      <text class="week-day-date">{{item.dayText}}</text>
      <text class="week-day-hint">{{item.hasMenu ? item.publishedCount + ' 餐已发' : '未发布'}}</text>
      <text wx:if="{{item.wantEatCount}}" class="week-day-want">想吃 {{item.wantEatCount}}</text>
    </view>
  </scroll-view>
  <view wx:if="{{role === 'PARENT'}}" class="notice">这里发布的菜单只属于当前家庭，不会影响其他家庭或学校餐单。</view>
  <view wx:if="{{role === 'PARENT'}}" class="tabs source-tabs">
    <button class="{{sourceTab === 'FAMILY' ? 'active' : ''}}" bindtap="sourceTab" data-tab="FAMILY" disabled="{{busy}}">家庭菜品</button>
    <button class="{{sourceTab === 'PRESET' ? 'active' : ''}}" bindtap="sourceTab" data-tab="PRESET" disabled="{{busy}}">预置菜品</button>
  </view>
  <view wx:if="{{role === 'PARENT'}}" class="source-count">已选 <text class="price">{{count}}</text> / 50 道（家庭 + 预置合计）</view>
  <view wx:if="{{role === 'CHILD'}}" class="tabs">
    <button class="{{sourceType === 'FAMILY' ? 'active' : ''}}" bindtap="source" data-source="FAMILY" disabled="{{busy}}">家庭餐单</button>
    <button class="{{sourceType === 'SCHOOL' ? 'active' : ''}}" bindtap="source" data-source="SCHOOL" disabled="{{busy}}">学校餐单</button>
  </view>
  <view wx:if="{{schoolBoundaryText}}" class="notice school-boundary-notice">{{schoolBoundaryText}}</view>
  <view wx:if="{{role === 'CHILD' && recommend.length}}" class="quick-section recommend-section">
    <view class="quick-head"><text class="quick-title">今天吃什么？</text><text class="small">点一下收藏，只记录你的偏好</text></view>
    <scroll-view class="quick-scroll" scroll-x="true" enable-flex="true">
      <view wx:for="{{recommend}}" wx:key="key" class="quick-card {{item.available ? '' : 'quick-card-disabled'}} {{item.isFavorite ? 'quick-card-active' : ''}}" bindtap="quickFavorite" data-key="{{item.key}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="quick-image" />
        <view wx:else class="quick-image quick-fallback">🍲</view>
        <view class="quick-name">{{item.name}}</view>
        <view class="quick-meta">{{item.actionLabel}}</view>
        <view class="quick-hint">{{item.actionHint}}</view>
        <view wx:if="{{item.reasonText}}" class="quick-reason">{{item.reasonText}}</view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{role === 'CHILD' && frequent.length}}" class="quick-section">
    <view class="quick-head"><text class="quick-title">孩子常吃</text><text class="small">点一下收藏，只记录你的偏好</text></view>
    <scroll-view class="quick-scroll" scroll-x="true" enable-flex="true">
      <view wx:for="{{frequent}}" wx:key="key" class="quick-card {{item.available ? '' : 'quick-card-disabled'}} {{item.isFavorite ? 'quick-card-active' : ''}}" bindtap="quickFavorite" data-key="{{item.key}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="quick-image" />
        <view wx:else class="quick-image quick-fallback">🍲</view>
        <view class="quick-name">{{item.name}}</view>
        <view class="quick-meta">{{item.actionLabel}}</view>
        <view class="quick-hint">{{item.actionHint}}</view>
      </view>
    </scroll-view>
  </view>
  <!-- 心愿菜单（P3）：位于「每日想吃」相关区块下方。儿童勾选候选池并提交，家长查看并配置上限。 -->
  <view wx:if="{{role === 'CHILD' && wish}}" class="wish-section">
    <view class="quick-head">
      <text class="quick-title">{{wish.titleText}}</text>
      <text class="small">已选 {{wish.countText}} 道 · {{wish.stateLabel}}</text>
    </view>
    <view class="notice">{{wish.noticeText}}</view>
    <view wx:if="{{wish.items.length}}" class="wish-pool">
      <view wx:for="{{wish.items}}" wx:key="key" class="wish-chip {{item.checked ? 'selected' : ''}} {{!wish.canEdit || item.missing || !item.selectable ? 'wish-chip-disabled' : ''}}" bindtap="wishToggle" data-key="{{item.key}}">
        <text class="wish-chip-mark">{{item.checked ? '✓' : '○'}}</text>
        <text class="wish-chip-name">{{item.displayName}}</text>
        <text wx:if="{{item.flags}}" class="wish-chip-flag">{{item.flags}}</text>
        <text wx:if="{{item.submitted}}" class="wish-chip-tag">已提交</text>
      </view>
    </view>
    <view wx:else class="small">{{wish.showCatalog ? '还没有心愿候选菜品' : '当天暂无心愿菜品记录'}}</view>
    <view wx:if="{{wish.canEdit}}" class="wish-submit-note">提交后家长才能看到这份心愿清单</view>
    <view wx:if="{{wish.canEdit || wish.locked}}" class="parent-actions wish-actions">
      <button wx:if="{{wish.canEdit}}" class="primary" bindtap="wishSubmit" disabled="{{busy || !wishSelected.length}}">提交给家长</button>
      <button wx:if="{{wish.locked}}" bindtap="wishWithdraw" disabled="{{busy}}">撤回</button>
    </view>
    <view wx:if="{{wish.showCatalog}}" class="wish-catalog">
      <view class="tabs source-tabs">
        <button class="{{wishTab === 'FAMILY' ? 'active' : ''}}" bindtap="wishCatalogTab" data-tab="FAMILY" disabled="{{busy}}">家庭菜谱</button>
        <button class="{{wishTab === 'PRESET' ? 'active' : ''}}" bindtap="wishCatalogTab" data-tab="PRESET" disabled="{{busy}}">预置菜谱</button>
      </view>
      <view class="search-box"><text class="search-icon">⌕</text><input value="{{wishKeyword}}" bindinput="wishSearch" placeholder="搜索菜谱" maxlength="64" disabled="{{busy}}" /></view>
      <view wx:for="{{wishDishes}}" wx:key="key" class="wish-dish">
        <view class="wish-dish-main">
          <text class="wish-dish-name">{{item.name}}</text>
          <text class="small">{{item.typeLabel}} · {{item.categoryName || '未分类'}} · {{item.safetyLabel}}</text>
        </view>
        <button class="compact-action" bindtap="wishMark" data-type="{{item.type}}" data-id="{{item.id}}" data-marked="{{item.marked}}" disabled="{{busy || !wish.showCatalog || (!item.selectable && !item.marked)}}">{{item.actionLabel}}</button>
      </view>
      <view wx:if="{{wishTotal > wishPageSize || wishPage > 1}}" class="wish-pager">
        <button bindtap="wishPageDelta" data-delta="-1" disabled="{{busy || wishPage <= 1}}">上一页</button>
        <text class="small">第 {{wishPage}} 页 · 共 {{wishTotal}} 道</text>
        <button bindtap="wishPageDelta" data-delta="1" disabled="{{busy || wishPage * wishPageSize >= wishTotal}}">下一页</button>
      </view>
    </view>
  </view>
  <view wx:if="{{role === 'PARENT' && wish}}" class="wish-section">
    <view class="quick-head">
      <text class="quick-title">孩子的心愿菜单</text>
      <text class="small">{{wish.menuDate}} · {{wish.statusLabel}}</text>
    </view>
    <picker wx:if="{{children.length > 1}}" class="child-picker" range="{{childLabels}}" value="{{childIndex}}" bindchange="child" disabled="{{busy}}"><view>{{childLabels[childIndex]}}⌄</view></picker>
    <view class="notice">{{wish.locked ? '已提交 · ' + wish.submitTimeText : wish.status === 'WITHDRAWN' ? '孩子已撤回，可等待重新提交。' : !wish.enabled ? '心愿菜单未开启；普通「想吃」标记仍可用。' : '孩子还没有提交当天的心愿菜单（该功能可选，不强制每天创建）。'}}</view>
    <view wx:if="{{wish.items.length}}" class="wish-pool">
      <view wx:for="{{wish.items}}" wx:key="key" class="wish-chip selected" data-key="{{item.key}}">
        <text class="wish-chip-mark">✓</text>
        <text class="wish-chip-name">{{item.displayName}}</text>
        <text wx:if="{{item.flags}}" class="wish-chip-flag">{{item.flags}}</text>
      </view>
    </view>
    <view wx:else class="small">{{wish.status === 'NONE' ? '孩子还没有创建当天的心愿菜单。' : '这次提交里没有可展示的菜品（可能已全部下架）。'}}</view>
    <view class="wish-setting">
      <view class="small">心愿菜单设置：上限 {{wishMaxDraft}} 道（当前 {{wish.maxDishes}} 道）</view>
      <picker range="{{wishDishRange}}" value="{{wishMaxDraft - 1}}" bindchange="wishMax" disabled="{{busy}}"><view class="picker">最多 {{wishMaxDraft}} 道⌄</view></picker>
      <label class="filter-chip {{wishEnabledDraft ? 'selected' : ''}}"><switch checked="{{wishEnabledDraft}}" bindchange="wishEnabled" disabled="{{busy}}" />启用心愿菜单</label>
      <button bindtap="wishSettingSave" disabled="{{busy || !wishSettings}}">保存设置</button>
    </view>
  </view>
  <view wx:if="{{role === 'CHILD'}}" class="meal-segments">
    <view class="meal-segment {{mealType === 'BREAKFAST' ? 'on' : ''}}" bindtap="mealSegment" data-meal="BREAKFAST" aria-role="button">早餐</view>
    <view class="meal-segment {{mealType === 'LUNCH' ? 'on' : ''}}" bindtap="mealSegment" data-meal="LUNCH" aria-role="button">午餐</view>
    <view class="meal-segment {{mealType === 'DINNER' ? 'on' : ''}}" bindtap="mealSegment" data-meal="DINNER" aria-role="button">晚餐</view>
  </view>
  <view class="filter-row">
    <picker wx:if="{{role === 'PARENT'}}" range="{{meals}}" value="{{mealIndex}}" bindchange="meal" disabled="{{busy}}"><view class="picker meal-picker">{{meals[mealIndex]}}⌄</view></picker>
    <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="search" placeholder="搜索餐食" maxlength="64" disabled="{{busy}}" /></view>
  </view>
  <checkbox-group bindchange="filters" class="filter-chips">
    <label class="filter-chip {{mildOnly ? 'selected' : ''}}"><checkbox value="mild" checked="{{mildOnly}}" disabled="{{busy}}" />无辣</label>
    <label wx:if="{{role === 'CHILD'}}" class="filter-chip {{favoritesOnly ? 'selected' : ''}}"><checkbox value="favorite" checked="{{favoritesOnly}}" disabled="{{busy}}" />今天想吃</label>
  </checkbox-group>
  <scroll-view wx:if="{{categories.length > 2 && role === 'CHILD'}}" class="category-chips" scroll-x="true" enable-flex="true">
    <view wx:for="{{categories}}" wx:key="id" class="category-chip {{categoryId === item.id ? 'selected' : ''}}" bindtap="category" data-id="{{item.id}}">{{item.name}}<text class="category-count">{{item.count}}</text></view>
  </scroll-view>
  <view wx:if="{{menu && menu.missingDishIds.length}}" class="notice">部分菜品已不可用，请以当前餐单为准。</view>
  <view wx:if="{{role === 'PARENT' && invalidSelectedCount}}" class="notice warning-notice">
    当前选择中有 {{invalidSelectedCount}} 项已下架或删除，移除后才能发布。
    <button class="compact-action" bindtap="clearUnavailable" disabled="{{busy}}">移除失效项</button>
  </view>
  <view wx:if="{{busy && !ready}}" class="skeleton-list">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="item dish skeleton-card"><view class="skeleton-image"></view><view class="skeleton-content"><view class="skeleton-line wide"></view><view class="skeleton-line"></view><view class="skeleton-line short"></view></view></view>
    <view class="loading">正在加载好吃的菜单…</view>
  </view>
  <view wx:if="{{error}}" class="error-state">
    <view class="error-state-icon">!</view>
    <view class="error-state-title">餐单暂时没有加载出来</view>
    <view class="muted">{{error}}</view>
    <button bindtap="retry" disabled="{{busy}}">重新加载</button>
  </view>
  <view wx:if="{{ready && !dishes.length && !error}}" class="empty-state">
    <view class="empty-state-icon">🍽️</view>
    <view class="section-title">{{role === 'PARENT' ? '暂无可选餐食' : '没有符合条件的餐食'}}</view>
    <view class="muted">{{role === 'PARENT' ? '可在「我的菜品」录入家庭菜品，或切到预置菜品选择。' : '换个筛选条件再看看吧。'}}</view>
    <button wx:if="{{role === 'PARENT'}}" bindtap="goDishManage" disabled="{{busy}}">去录入我的菜品</button>
  </view>
  <view wx:if="{{role === 'PARENT'}}" class="dual-layout">
    <view class="side-nav">
      <view wx:for="{{categories}}" wx:key="id" class="side-nav-item {{categoryId === item.id ? 'on' : ''}}" bindtap="category" data-id="{{item.id}}">
        <text class="side-nav-name">{{item.name}}</text>
        <text class="side-nav-count">{{item.count}}</text>
      </view>
    </view>
    <view class="dish-flow">
      <view wx:for="{{dishes}}" wx:key="key" class="dish-row {{item.inCart ? 'in-cart' : ''}} {{!item.available ? 'row-disabled' : ''}}" bindtap="openDishDetail" data-key="{{item.key}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="row-img" catchtap="imageError" data-key="{{item.key}}" />
        <view wx:else class="row-img row-fallback">🍲</view>
        <view class="row-main">
          <view class="row-title">{{item.name}}</view>
          <view class="row-meta">{{item.categoryName || '未分类'}} · {{item.spiceLabel}}</view>
          <view wx:if="{{item.hasSpice && item.inCart}}" class="row-spice">
            <text class="spice-opt {{item.spice === 0 ? 'on' : ''}}" catchtap="parentSpice" data-key="{{item.key}}" data-index="0">不辣</text>
            <text class="spice-opt {{item.spice === 1 ? 'on' : ''}}" catchtap="parentSpice" data-key="{{item.key}}" data-index="1">微辣</text>
            <text class="spice-opt {{item.spice === 2 ? 'on' : ''}}" catchtap="parentSpice" data-key="{{item.key}}" data-index="2">中辣</text>
          </view>
          <view wx:if="{{item.note}}" class="row-note">备注：{{item.note}}</view>
        </view>
        <view class="row-side">
          <view class="row-price">¥<text class="row-price-num">{{item.selPrice}}</text><text class="row-price-unit">/份</text></view>
          <view wx:if="{{item.inCart}}" class="row-qty">×{{item.quantity}}</view>
          <view wx:if="{{!item.available}}" class="row-off">已下架</view>
          <view wx:elif="{{!item.inCart}}" class="row-add" catchtap="parentAdd" data-key="{{item.key}}" aria-role="button">+</view>
        </view>
      </view>
      <view wx:if="{{!dishes.length}}" class="empty-inline">{{categories.length ? '该分类暂无餐食' : '暂无可选餐食'}}</view>
    </view>
  </view>
  <view wx:if="{{role === 'CHILD'}}" class="child-list">
    <view wx:for="{{dishes}}" wx:key="key" class="item dish {{item.quantity > 0 ? 'selected-dish' : ''}} {{!item.selectable ? 'disabled-dish' : ''}}">
      <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="dish-image" binderror="imageError" data-key="{{item.key}}" />
      <view wx:else class="dish-image fallback"><text class="fallback-icon">🍲</text><text>暂无图片</text></view>
      <view class="dish-content">
        <view class="dish-title-row">
          <view class="section-title">{{item.name}}</view>
          <view class="favorite-control">
            <button class="favorite-button {{item.isFavorite ? 'active' : ''}}" bindtap="favorite" data-key="{{item.key}}" disabled="{{busy}}" aria-label="{{item.favoriteAriaLabel}}">{{item.isFavorite ? '♥' : '♡'}}</button>
            <text class="favorite-caption">{{item.isFavorite ? '已收藏' : '收藏这道菜'}}</text>
          </view>
        </view>
        <view><text wx:if="{{item.categoryName}}" class="badge">{{item.categoryName}}</text><text class="badge">{{item.spiceLabel}}</text><text class="badge {{item.selectable ? 'safe' : 'warning'}}">{{item.safetyLabel}}</text></view>
        <view class="small">{{item.calories === null ? '热量暂无数据' : item.calories + ' kcal / 份'}}</view>
        <view wx:if="{{item.isDisliked}}" class="small">包含不喜欢的食物</view>
        <view class="price-chip">{{item.virtualPrice}} <text class="price-chip-unit">币</text></view>
        <view class="stepper" wx:if="{{sourceType === 'FAMILY'}}">
          <button class="icon-button" bindtap="quantity" data-key="{{item.key}}" data-delta="-1" disabled="{{busy || item.quantity === 0}}" aria-label="减少一份">−</button>
          <text class="quantity">{{item.quantity}}</text>
          <button class="icon-button" bindtap="quantity" data-key="{{item.key}}" data-delta="1" disabled="{{busy || !item.selectable || !menu.canSubmit || item.quantity === 9}}" aria-label="增加一份">+</button>
        </view>
      </view>
    </view>
  </view>
  <view class="cartbar-tools" wx:if="{{role === 'PARENT' && ready}}">
    <text bindtap="goDishManage" disabled="{{busy}}">我的菜品</text>
    <text bindtap="goWeekPlan" disabled="{{busy}}">整周发布</text>
    <text class="cartbar-tools-note">已选 {{count}} / 50 道{{menu ? ' · 已发布可调整' : ''}}</text>
  </view>
  <view class="cartbar" wx:if="{{role === 'PARENT' && ready}}">
    <view class="cartbar-info">
      <view class="cartbar-count">已选 {{count}} 道</view>
      <view class="cartbar-total">合计 ¥<text class="cartbar-total-num">{{parentTotal}}</text></view>
    </view>
    <view class="cartbar-actions">
      <view class="cartbar-mini {{busy || !count || invalidSelectedCount ? 'off' : ''}}" bindtap="saveDraft" aria-role="button">存草稿</view>
      <button class="primary cartbar-publish" bindtap="saveMenu" disabled="{{busy || !count || invalidSelectedCount}}">发布</button>
    </view>
  </view>
  <view class="checkout-panel" wx:if="{{role === 'CHILD' && sourceType === 'FAMILY' && menu}}">
    <view class="checkout-summary"><view><view class="small">已选 {{count}} 种</view><view class="checkout-note">家长同意后才记账</view></view><view class="price">{{total}} <text class="small">虚拟单位</text></view></view>
    <button class="primary" bindtap="checkout" disabled="{{busy || !count || !menu.canSubmit || menuDate !== today}}">请家长确认</button>
  </view>
  <view wx:if="{{busy && ready}}" class="loading-float">正在处理</view>

  <!-- 家长 · 菜品详情弹层 -->
  <view wx:if="{{detail}}" class="detail-mask" catchtap="closeDetail">
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-head">
        <view>
          <view class="detail-title">{{detail.name}}</view>
          <view class="detail-meta">{{detail.categoryName}} · {{detail.spiceLabel}}</view>
        </view>
        <view class="detail-close" bindtap="closeDetail" aria-role="button">×</view>
      </view>
      <view class="detail-row">
        <text class="detail-label">份数</text>
        <view class="stepper detail-stepper">
          <button class="icon-button" bindtap="detailQuantity" data-delta="-1" disabled="{{busy || detail.quantity === 0}}" aria-label="减少一份">−</button>
          <text class="quantity">{{detail.quantity}}</text>
          <button class="icon-button" bindtap="detailQuantity" data-delta="1" disabled="{{busy || detail.quantity === 99}}" aria-label="增加一份">+</button>
        </view>
      </view>
      <view wx:if="{{detail.hasSpice}}" class="detail-row">
        <text class="detail-label">辣度</text>
        <view class="spice-pick">
          <text class="spice-opt {{detail.spice === 0 ? 'on' : ''}}" bindtap="detailSpice" data-index="0">不辣</text>
          <text class="spice-opt {{detail.spice === 1 ? 'on' : ''}}" bindtap="detailSpice" data-index="1">微辣</text>
          <text class="spice-opt {{detail.spice === 2 ? 'on' : ''}}" bindtap="detailSpice" data-index="2">中辣</text>
        </view>
      </view>
      <view class="detail-row">
        <text class="detail-label">单价</text>
        <view class="price-pick">
          <view class="step-btn" bindtap="detailPrice" data-delta="-1" aria-role="button">−</view>
          <text class="price-num">¥{{detail.price}}</text>
          <view class="step-btn" bindtap="detailPrice" data-delta="1" aria-role="button">+</view>
        </view>
      </view>
      <view class="detail-row note-row">
        <text class="detail-label">备注</text>
        <input class="note-input" value="{{detail.note}}" bindinput="detailNote" placeholder="口味、忌口等备注" maxlength="30" disabled="{{busy}}" />
        <view class="quick-tags">
          <text class="quick-tag" bindtap="quickNote" data-tag="少辣">少辣</text>
          <text class="quick-tag" bindtap="quickNote" data-tag="不要花生">不要花生</text>
          <text class="quick-tag" bindtap="quickNote" data-tag="少油">少油</text>
        </view>
      </view>
      <button class="primary detail-confirm" bindtap="detailConfirm" disabled="{{busy}}">{{detail.quantity > 0 ? (detail.inCart ? '保存修改' : '加入今日菜单') : '移除这道菜'}}</button>
    </view>
  </view>
</view>
