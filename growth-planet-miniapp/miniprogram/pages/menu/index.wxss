.menu-page { padding-bottom: 56px; }
.source-tabs { margin-bottom: 8px; }
.source-count { margin: 0 2px 10px; color: #687386; font-size: 13px; }
.parent-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.parent-actions button { flex: 1; min-width: 96px; }
.checkout-panel .parent-actions .primary { width: auto; }
.menu-header { align-items: flex-end; }
.date-picker { width: auto; min-width: 118px; min-height: 44px; padding: 10px 12px; color: var(--primary); font-weight: 700; text-align: center; }
.child-picker { margin-bottom: 12px; color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary-border); }
.filter-row { display: flex; align-items: center; gap: 10px; }
.meal-picker { width: 94px; min-width: 94px; text-align: center; font-weight: 600; }
.search-box { flex: 1; min-width: 0; position: relative; }
.search-box input { padding-left: 40px; }
.search-icon { position: absolute; left: 14px; top: 0; z-index: 1; color: #687386; font-size: 20px; line-height: 48px; }
.filter-chips { display: flex; align-items: center; gap: 8px; margin: 12px 0 4px; }
.filter-chip { min-height: 40px; padding: 7px 13px; border: 1px solid #e6ebf2; border-radius: 20px; background: #fff; color: #5b6776; font-size: 13px; font-weight: 600; display: flex; align-items: center; }
.filter-chip checkbox { width: 0; height: 0; opacity: 0; margin: 0; }
.filter-chip.selected { color: var(--primary); background: var(--primary-soft); border-color: var(--primary-border); }
.dish { display: flex; align-items: flex-start; gap: 14px; transition: transform .2s ease, opacity .2s ease; }
.selected-dish { border-color: var(--primary-border); box-shadow: 0 1px 3px rgba(20, 40, 80, .06), 0 8px 22px rgba(29, 78, 216, .10); }
.parent .selected-dish { box-shadow: 0 1px 3px rgba(20, 40, 80, .06), 0 8px 22px rgba(21, 128, 61, .10); }
.disabled-dish { opacity: .72; }
.dish-image { width: 96px; height: 96px; flex: 0 0 96px; border-radius: var(--radius-md); }
.fallback { background: #eef3fb; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: #687386; font-size: 11px; }
.fallback-icon { font-size: 26px; }
.dish-content { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.dish-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.dish-content .section-title { flex: 1; min-width: 0; margin-bottom: 6px; font-size: 17px; }
.favorite-button { width: 44px; min-width: 44px; height: 44px; padding: 0; border-radius: 50%; background: var(--primary-soft); color: var(--primary); font-size: 23px; line-height: 44px; }
.favorite-button.active { background: #fef2f2; color: #ef4444; }
.menu-select-control { min-width: 92px; min-height: 44px; padding: 8px 10px; border: 1px solid #d7dee8; border-radius: 10px; color: #435166; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 5px; }
.menu-select-control checkbox { transform: scale(.82); }
.menu-select-control.selected { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary-border); }
.menu-select-control.disabled { color: #697586; background: #e5e8ee; }
.stepper { display: flex; align-items: center; justify-content: flex-end; gap: 6px; margin-top: 12px; }
.stepper .icon-button { background: var(--primary-soft); color: var(--primary); border: 1px solid var(--primary-border); font-size: 20px; }
.quantity { width: 32px; text-align: center; font-variant-numeric: tabular-nums; }
.header { flex-wrap: wrap; }
.checkout-panel { position: sticky; bottom: 12px; z-index: 5; margin-top: 18px; padding: 14px; border: 1px solid #e6ebf2; border-radius: var(--radius-lg); background: rgba(255, 255, 255, .98); box-shadow: var(--shadow-strong); }
.checkout-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.checkout-note { color: #687386; font-size: 12px; margin-top: 2px; }
.checkout-panel .primary { width: 100%; }
.publish-status { color: var(--primary); font-size: 16px; font-weight: 700; }
.warning-notice { background: #fffbeb; color: #92400e; border-color: #fde68a; border-left-color: #d97706; }
.compact-action { min-height: 36px; margin-top: 10px; padding: 6px 12px; background: #fff; color: #92400e; border: 1px solid #fcd34d; font-size: 13px; line-height: 22px; }
.skeleton-card { box-shadow: none; }
.skeleton-image, .skeleton-line { background: #e8edf4; animation: skeletonPulse 1.2s ease-in-out infinite alternate; }
.skeleton-image { width: 96px; height: 96px; flex: 0 0 96px; border-radius: 12px; }
.skeleton-content { flex: 1; padding-top: 5px; }
.skeleton-line { width: 72%; height: 12px; border-radius: 6px; margin-bottom: 14px; }
.skeleton-line.wide { width: 90%; height: 18px; }
.skeleton-line.short { width: 48%; }
.error-state, .empty-state { padding: 40px 22px; margin: 18px 0; background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-lg); text-align: center; box-shadow: var(--shadow-soft); }
.error-state-icon, .empty-state-icon { width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 30px; }
.error-state-icon { background: #fef2f2; color: #ef4444; font-weight: 800; }
.empty-state-icon { background: var(--primary-soft); color: var(--primary); }
.error-state-title { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
.error-state button { margin: 18px auto 0; }
.loading-float { position: fixed; left: 50%; bottom: 24px; z-index: 20; transform: translateX(-50%); padding: 8px 14px; border-radius: 18px; background: rgba(31, 39, 51, .88); color: #fff; font-size: 13px; }
@keyframes skeletonPulse {
  from { opacity: .55; }
  to { opacity: 1; }
}
@media (max-width: 380px) {
  .dish { gap: 10px; }
  .dish-image { width: 82px; height: 82px; flex-basis: 82px; }
  .menu-select-control { min-width: 44px; width: 44px; padding: 8px 4px; }
  .menu-select-control text { display: none; }
}
