.dish { display: flex; align-items: flex-start; gap: 14px; }
.dish-image { width: 82px; height: 82px; flex: 0 0 82px; border-radius: 6px; }
.fallback { background: #eef1f5; display: flex; align-items: center; justify-content: center; color: #59677a; font-size: 12px; }
.dish-content { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.dish-content .section-title { margin-bottom: 6px; }
.stepper { display: flex; align-items: center; justify-content: flex-end; gap: 6px; margin-top: 12px; }
.quantity { width: 32px; text-align: center; font-variant-numeric: tabular-nums; }
.header { flex-wrap: wrap; }
