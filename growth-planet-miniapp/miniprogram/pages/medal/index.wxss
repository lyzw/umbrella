.page { min-height: 100vh; background: #f7f9fc; padding: 22rpx 22rpx 160rpx; box-sizing: border-box; }
.head { padding: 12rpx 8rpx 4rpx; }
.title { font-size: 38rpx; font-weight: 700; color: #1f2d3d; }
.sub { display: block; font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }

.bar { margin: 12rpx 8rpx; }
.picker { display: inline-block; padding: 14rpx 20rpx; background: #fff; border-radius: 14rpx; font-size: 26rpx; color: #1f2d3d; box-shadow: 0 2rpx 8rpx rgba(31,45,61,.06); }

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 8rpx; }
.medal { width: calc(50% - 8rpx); background: #fff; border-radius: 18rpx; padding: 24rpx 18rpx; text-align: center; box-shadow: 0 2rpx 10rpx rgba(31,45,61,.06); }
.medal.off { opacity: .55; }
.medal.on { box-shadow: 0 4rpx 16rpx rgba(40,120,255,.18); }
.icon { font-size: 64rpx; line-height: 1; }
.m-name { font-size: 28rpx; font-weight: 600; color: #1f2d3d; margin-top: 12rpx; }
.m-desc { font-size: 22rpx; color: #8a94a6; margin-top: 6rpx; min-height: 56rpx; }
.m-state { font-size: 22rpx; color: #2878ff; margin-top: 10rpx; }
.medal.off .m-state { color: #8a94a6; }

.empty { text-align: center; color: #8a94a6; font-size: 26rpx; padding: 40rpx 0; }
