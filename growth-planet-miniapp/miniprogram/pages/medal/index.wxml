<view class="page {{role === 'PARENT' ? 'parent' : ''}}">
  <page-back role="{{role}}" fallback-tab="{{role === 'CHILD' ? 'growth' : 'home'}}" disabled="{{busy}}" />
  <view class="page-heading">
    <text class="title">勋章墙</text>
    <text class="subtitle">每一次努力，都被看见</text>
  </view>

  <view wx:if="{{children.length}}" class="toolbar">
    <picker mode="selector" range="{{children}}" range-key="displayName" bindchange="child">
      <view class="picker compact-picker">{{children[childIndex].displayName}}</view>
    </picker>
  </view>

  <view wx:if="{{medalTotal}}" class="medal-overview">
    <text class="medal-overview-label">成长进度</text>
    <text class="medal-overview-value">已点亮 {{medalEarned}} / 共 {{medalTotal}} 枚</text>
  </view>

  <view class="grid">
    <view wx:for="{{medals}}" wx:key="definitionId" class="medal {{item.earned ? 'on' : 'off'}}">
      <view class="icon">{{item.definition.icon}}</view>
      <view class="medal-name">{{item.definition.name}}</view>
      <view class="medal-description">{{item.definition.description}}</view>
      <view class="medal-state">{{item.stateText}}</view>
    </view>
  </view>

  <view wx:if="{{medals.length === 0}}" class="empty">还没有勋章，去完成家务解锁吧</view>
</view>
