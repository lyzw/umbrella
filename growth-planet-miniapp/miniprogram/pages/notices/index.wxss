/* 通知记录项：整卡可点，按压反馈 */
.item { transition: transform var(--motion-fast), background-color var(--motion-fast); }
.item:active { transform: scale(.99); background: var(--surface-2); }
/* 未读 / 已读徽标语义化 */
.unread-badge {
  background: var(--primary);
  color: #fff;
}
.read-badge {
  background: #fff;
  color: #5b6776;
  border: 1px solid #cbd5e1;
}
/* 仅看未读开关行与记录区留出间距 */
.row { padding: 4px 0; }
.actions { margin-top: 16px; }

/* ===== 通知 · 温柔空态 ===== */
.notices-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 24px; }
.notices-empty .empty-icon {
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--surface-2, #eef0f4);
  font-size: 26px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 4px;
}
.notices-empty .empty-title { font-size: 14px; font-weight: 800; color: #344054; }
.notices-empty .empty-hint { font-size: 12px; color: #9aa1ac; }
