<view class="page {{role === 'PARENT' ? 'parent' : ''}}">
  <view class="header"><view class="title">家庭与绑定</view><button bindtap="refresh" disabled="{{busy}}">刷新</button></view>
  <view wx:if="{{role === 'CHILD'}}">
    <view class="notice">{{binding ? binding.label : '正在查询绑定状态'}}</view>
    <view wx:if="{{binding.bindStatus === 'NONE' || binding.bindStatus === 'REJECTED'}}" class="field">
      <text class="label">家长提供的邀请码</text><input value="{{inviteCode}}" bindinput="input" data-field="inviteCode" maxlength="6" />
      <view class="actions"><button class="primary" disabled="{{busy}}" bindtap="join">申请加入家庭</button></view>
    </view>
    <view class="muted" wx:if="{{binding.bindStatus === 'PENDING'}}">申请已送出，请家长在自己的账号中确认。</view>
    <view class="muted" wx:if="{{binding.bindStatus === 'BOUND'}}">家庭已连接。请家长完成同意与档案后，再查看餐单。</view>
  </view>
  <view wx:else>
    <view wx:if="{{!hasFamily}}" class="section">
      <text class="label">家庭名称</text><input value="{{familyName}}" data-field="familyName" bindinput="input" maxlength="64" />
      <view class="actions"><button class="primary" disabled="{{busy}}" bindtap="create">创建家庭</button></view>
    </view>
    <view wx:else>
      <view class="invite-panel">
        <view>
          <view class="section-title">邀请家庭成员</view>
          <view class="muted">邀请码仅分享给当前家庭成员，过期后可重新获取。</view>
        </view>
        <button bindtap="invitation" disabled="{{busy}}">查看邀请码</button>
      </view>
      <view wx:if="{{invite}}" class="notice invite-code"><view class="invite-value">{{invite.inviteCode}}</view><view class="small">请通过可信方式发送给家庭成员。</view></view>
      <view class="section member-section">
        <view class="section-title">儿童申请与关系</view>
        <view wx:if="{{!children.length}}" class="empty">暂时没有儿童申请</view>
        <button wx:for="{{children}}" wx:key="applyId" class="link-row {{selected && selected.applyId === item.applyId ? 'selected' : ''}}" bindtap="inspect" data-id="{{item.applyId}}">
          <view class="member-copy"><text class="member-name">{{item.displayName}}</text><text class="small">查看绑定进度与下一步</text></view>
          <text class="badge {{item.bindStatus === 'BOUND' ? 'positive' : ''}}">{{item.bindStatusLabel}}</text>
        </button>
        <view class="actions"><button bindtap="next" data-delta="-1" disabled="{{busy || page === 1}}">上一页</button><button bindtap="next" data-delta="1" disabled="{{busy || page * 20 >= total}}">下一页</button></view>
      </view>
      <view wx:if="{{selected && consent}}" class="section">
        <view class="flow-heading">
          <view>
            <view class="eyebrow">绑定进度</view>
            <view class="section-title">{{selected.displayName}}</view>
          </view>
          <text class="small">第 {{currentBindingStep}} / 4 步</text>
        </view>
        <view class="binding-steps">
          <view wx:for="{{bindingSteps}}" wx:key="step" class="binding-step {{item.status}}">
            <view class="step-marker">{{item.status === 'done' ? '✓' : item.step}}</view>
            <view class="step-label">{{item.label}}</view>
          </view>
        </view>

        <view wx:if="{{currentBindingStep === 2}}" class="current-task">
          <view class="section-title">阅读并记录档案同意</view>
          <view class="agreement-text">{{consent.agreementText}}</view>
          <text class="label">家长自报年龄</text><input type="number" value="{{age}}" bindinput="input" data-field="age" maxlength="3" />
          <checkbox-group bindchange="agree"><label class="check"><checkbox value="yes" checked="{{agreed}}" />我已阅读并同意本协议</label></checkbox-group>
          <view class="muted">自报年龄仅为声明，不代表身份或监护关系已核验。</view>
          <view class="actions">
            <button wx:if="{{selected.bindStatus === 'PENDING'}}" bindtap="approve" data-approve="no" disabled="{{busy}}">拒绝申请</button>
            <button class="primary" bindtap="grantConsent" disabled="{{busy || !agreed}}">记录同意并继续</button>
          </view>
        </view>

        <view wx:elif="{{currentBindingStep === 3}}" class="current-task">
          <view class="section-title">确认家庭关系</view>
          <view class="muted">同意记录已完成。请确认该儿童属于当前家庭，再建立绑定关系。</view>
          <view class="field"><text class="label">家庭关系称呼（选填）</text><input value="{{relationLabel}}" data-field="relationLabel" bindinput="input" maxlength="32" /></view>
          <view class="actions"><button bindtap="approve" data-approve="no" disabled="{{busy}}">拒绝申请</button><button class="primary" bindtap="approve" data-approve="yes" disabled="{{busy}}">确认绑定</button></view>
        </view>

        <view wx:else class="current-task complete-task">
          <view class="section-title">家庭绑定已完成</view>
          <view class="muted">接下来可以维护孩子的昵称、口味、忌口和过敏信息。</view>
          <view class="actions"><button class="primary" bindtap="profile">维护儿童档案</button></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
