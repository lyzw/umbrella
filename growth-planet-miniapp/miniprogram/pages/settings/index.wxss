.page { background: var(--bg, #f5f6f8); min-height: 100vh; padding: 20px 20px 40px; box-sizing: border-box; }
.page.parent { --primary: #0b8a66; --primary-soft: #e2f3ec; --primary-border: #b8e2d2; }
.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.title { font-size: 20px; font-weight: 800; color: #172033; }
.error { margin: 10px 0; padding: 10px 14px; background: var(--danger-soft, #fdeeee); color: var(--danger, #c53030); border-radius: 12px; font-size: 13px; }
.section { margin-bottom: 18px; }
.section-title { font-size: 13px; font-weight: 800; color: #6b7480; margin-bottom: 8px; padding-left: 2px; }
.settings-card { background: #fff; border: 1px solid var(--line, #e3e6eb); border-radius: var(--radius-lg, 16px); overflow: hidden; }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; }
.setting-row + .setting-row { border-top: 1px solid var(--hairline, #f0f1f4); }
.setting-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.setting-name { font-size: 14px; font-weight: 700; color: #172033; }
.setting-desc { font-size: 12px; color: #6b7480; line-height: 1.5; }
.picker { font-size: 14px; font-weight: 700; color: var(--primary); padding: 6px 10px; background: var(--primary-soft, #e8f0ff); border-radius: 10px; }
.save-button { margin-top: 12px; }
.settings-note { padding: 12px 14px; background: var(--surface-2, #eef0f4); border-radius: var(--radius-lg, 16px); }
