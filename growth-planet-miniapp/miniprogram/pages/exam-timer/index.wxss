.page-heading.center { text-align: center; margin-bottom: 18px; }
.subject-tabs { display: flex; gap: 6px; justify-content: center; margin-bottom: 8px; }
.subject-tab {
  padding: 6px 16px;
  border-radius: 99px;
  background: var(--surface-2);
  font-size: 13px;
  color: var(--muted);
}
.subject-tab.on {
  background: var(--primary);
  color: #fff;
  font-weight: 800;
}

.timer-ring-wrap {
  position: relative;
  width: 220px;
  height: 220px;
  margin: 10px auto 6px;
}
.timer-ring { display: block; }
.timer-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.timer-time { font-size: 48px; font-weight: 800; line-height: 1; color: #172033; font-variant-numeric: tabular-nums; }
.timer-sub { font-size: 12px; color: var(--muted); }

.timer-chips { display: flex; gap: 8px; justify-content: center; margin-bottom: 22px; }
.timer-chip {
  padding: 6px 14px;
  border-radius: 99px;
  background: var(--surface-2);
  font-size: 12px;
  color: var(--muted);
}

.timer-controls { display: flex; gap: 14px; justify-content: center; align-items: center; }
.timer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 800;
  color: #fff;
}
.timer-btn.end {
  width: 56px;
  height: 56px;
  background: var(--surface-2);
  color: var(--muted);
  font-size: 13px;
}
.timer-btn.main {
  width: 68px;
  height: 68px;
  background: var(--primary);
  font-size: 15px;
  box-shadow: 0 10px 20px -8px rgba(47, 107, 255, .45);
}
.footnote { margin-top: 18px; text-align: center; font-size: 11px; color: var(--muted); }
