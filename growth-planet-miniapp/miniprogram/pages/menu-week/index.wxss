.page-heading { margin-bottom: 18px; }
.page-heading .subtitle { display: block; margin-bottom: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
.range-nav { display: flex; gap: 8px; }
.compact-action { flex: 0 0 auto; }
.week-label { display: block; }
.list-title { margin-top: 24px; }

.day-row { margin-bottom: 16px; padding: 12px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); }
.day-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
.day-name { font-size: 15px; font-weight: 800; }
.day-date { font-size: 12px; color: var(--muted); }
.meal-cells { display: flex; gap: 8px; }
.meal-cell {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  min-height: 56px;
  padding: 6px 4px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
}
.meal-cell.picked { border-color: var(--primary); background: var(--primary-soft); }
.meal-cell.empty-cell .meal-cell-status { color: var(--muted); }
.meal-cell-name { font-size: 13px; font-weight: 800; }
.meal-cell-status { font-size: 11px; color: #344054; text-align: center; overflow-wrap: anywhere; }
.day-tools { display: flex; gap: 8px; margin-top: 8px; }
.day-tools .compact-action { flex: 1 1 0; font-size: 12px; }

.dish-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.dish-chip {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 96px;
  max-width: 100%;
  padding: 8px 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}
.dish-chip.picked { border-color: var(--primary); background: var(--primary-soft); }
.dish-chip-name { font-size: 13px; font-weight: 800; overflow-wrap: anywhere; }
.dish-chip-type { font-size: 11px; color: var(--muted); }

.result-block { margin-top: 20px; }
.result-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); }
.result-text { font-size: 14px; overflow-wrap: anywhere; }
.badge.ok { color: #08764e; background: var(--positive-soft); }
.badge.normal { color: var(--muted); background: var(--surface-2); }

.publish-bar { position: sticky; bottom: 0; margin-top: 20px; padding-top: 12px; background: #f7f9fc; }
.publish-bar .primary { width: 100%; }

@media (max-width: 420px) {
  .toolbar { align-items: stretch; flex-direction: column; }
  .range-nav { width: 100%; }
  .meal-cells { flex-direction: column; }
  .day-tools { flex-direction: column; }
}
