.gender-tabs { display: flex; gap: 10px; }
.gender-tab { flex: 1; text-align: center; font-size: 15px; padding: 12px 0; border-radius: var(--radius-md); background: var(--surface); border: 1px solid var(--line); color: var(--muted); }
.gender-tab.on { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); font-weight: 800; }

.ref-line { display: block; margin-top: 8px; font-size: 12px; color: var(--muted); }
.ref-line { color: var(--muted); }
