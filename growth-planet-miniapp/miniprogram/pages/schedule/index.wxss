.page-heading { margin-bottom: 18px; }
.page-heading .subtitle { display: block; margin-bottom: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.compact-picker { min-width: 150px; }
.compact-action { flex: 0 0 auto; }
.form-panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-bottom: 22px;
  box-shadow: var(--shadow-soft);
}
.form-panel > input { margin-bottom: 12px; }
.form-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 12px; }
.form-row picker { min-width: 0; }
.form-submit { width: 100%; margin-top: 12px; }
.weekdays { margin-bottom: 12px; }
.weekdays .wd {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
  margin: 0 14px 8px 0;
  color: #344054;
  font-size: 14px;
}
.list-title { margin-top: 24px; }
.item-title { min-width: 0; font-size: 16px; font-weight: 800; line-height: 1.45; overflow-wrap: anywhere; }
.item-action { margin-top: 16px; }
.tappable-item:active { background: var(--surface-2); }
.badge.cat-home { color: #154a9e; background: var(--primary-soft); }
.badge.cat-class { color: #4a32b5; background: var(--c-shop-soft); }
.badge.cat-med { color: #9d241b; background: var(--danger-soft); }
.badge.cat-other { color: var(--muted); background: var(--surface-2); }

@media (max-width: 420px) {
  .toolbar:not(.week-toolbar) { align-items: stretch; flex-direction: column; }
  .compact-picker, .compact-action { width: 100%; }
  .form-row { grid-template-columns: 1fr; }
  .week-toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .week-toolbar picker { grid-column: 1 / -1; grid-row: 1; }
  .week-toolbar .compact-picker { min-width: 0; text-align: center; }
}
