<view class="page">
  <page-back role="{{role}}" fallback-tab="me" disabled="{{busy}}" />
  <view class="page-heading">
    <text class="title">学习工具</text>
    <text class="subtitle">按学习节奏，一个一个加上来</text>
  </view>

  <view class="group-label">正在用</view>
  <view class="tool-grid">
    <view class="tool-card live primary" bindtap="goExamTimer">
      <view class="tool-icon">⏱</view>
      <text class="tool-name">考试计时器</text>
      <text class="tool-desc">模拟考场节奏</text>
    </view>
    <view class="tool-card live accent" bindtap="tomato">
      <view class="tool-icon">🍅</view>
      <text class="tool-name">专注番茄钟</text>
      <text class="tool-desc">25 分钟专注</text>
    </view>
  </view>

  <view class="group-label">即将上线</view>
  <view class="tool-grid">
    <view class="tool-card soon" bindtap="comingSoon">
      <text class="tool-name">错题本</text>
      <text class="tool-desc">整理做错的题</text>
    </view>
    <view class="tool-card soon" bindtap="comingSoon">
      <text class="tool-name">口算练习</text>
      <text class="tool-desc">每天 10 题</text>
    </view>
    <view class="tool-card soon" bindtap="comingSoon">
      <text class="tool-name">背单词打卡</text>
      <text class="tool-desc">每天 5 个</text>
    </view>
    <view class="tool-card soon" bindtap="comingSoon">
      <text class="tool-name">护眼提醒</text>
      <text class="tool-desc">每 20 分钟休息</text>
    </view>
  </view>

  <view class="footnote">已上线的可直接打开，未上线的先占个位，后面陆续补上。</view>
  <view wx:if="{{busy}}" class="loading">正在处理</view>
</view>
