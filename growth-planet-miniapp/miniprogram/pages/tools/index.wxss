.group-label { margin: 2px 2px 8px; font-size: 12px; color: var(--muted); }
.tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 18px; }
.tool-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  min-width: 0;
  padding: 14px 14px 12px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}
.tool-card.live.primary { border-top: 3px solid var(--primary); }
.tool-card.live.accent { border-top: 3px solid var(--accent); }
.tool-card.soon { opacity: .55; }
.tool-icon { font-size: 20px; line-height: 1; }
.tool-name { margin-top: 8px; font-size: 13px; font-weight: 800; color: #172033; overflow-wrap: anywhere; }
.tool-desc { margin-top: 2px; font-size: 11px; color: var(--muted); }
.footnote { margin-top: 4px; text-align: center; font-size: 11px; color: var(--muted); }
