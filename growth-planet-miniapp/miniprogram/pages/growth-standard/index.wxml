<view class="page parent">
  <view class="page-heading">
    <text class="eyebrow">成长记录</text>
    <text class="title">WHO 生长标准</text>
  </view>

  <view class="filter-tabs">
    <text class="filter-tab {{ageBand === 'WHO 2006' ? 'on' : ''}}" bindtap="pickBand" data-band="WHO 2006">0–5 岁</text>
    <text class="filter-tab {{ageBand === 'WHO 2007' ? 'on' : ''}}" bindtap="pickBand" data-band="WHO 2007">5–19 岁</text>
  </view>
  <view class="filter-tabs">
    <text class="filter-tab {{gender === 'BOY' ? 'on' : ''}}" bindtap="pickGender" data-gender="BOY">男孩</text>
    <text class="filter-tab {{gender === 'GIRL' ? 'on' : ''}}" bindtap="pickGender" data-gender="GIRL">女孩</text>
  </view>
  <view class="filter-tabs metric">
    <text class="filter-tab {{metric === 'HEIGHT' ? 'on' : ''}}" bindtap="pickMetric" data-metric="HEIGHT">身高</text>
    <text class="filter-tab {{metric === 'WEIGHT' ? 'on' : ''}}" bindtap="pickMetric" data-metric="WEIGHT">体重</text>
    <text class="filter-tab {{metric === 'BMI' ? 'on' : ''}}" bindtap="pickMetric" data-metric="BMI">BMI</text>
  </view>

  <!-- 孩子定位条 -->
  <view wx:if="{{loc}}" class="loc-bar">
    <view class="loc-pin"></view>
    <text class="loc-text">{{loc}}，下表已高亮对应区间</text>
  </view>

  <!-- 孩子所在分位带图 -->
  <view wx:if="{{hasChild}}" class="band-card">
    <canvas type="2d" id="std-band" class="band-canvas"></canvas>
    <view class="band-legend">
      <text class="legend-item"><text class="legend-dot band"></text>P3–P97 参考区间</text>
      <text class="legend-item"><text class="legend-dot p50"></text>P50 中位数</text>
      <text class="legend-item"><text class="legend-dot kid"></text>孩子当前位置</text>
    </view>
  </view>

  <!-- 分位表 -->
  <view class="standard-card">
    <view class="table-scroll">
      <view class="std-row head">
        <view class="col age">年龄</view>
        <view class="col">P3<text class="th-sub">偏低</text></view>
        <view class="col">P15<text class="th-sub">中下</text></view>
        <view class="col">P50<text class="th-sub">中位</text></view>
        <view class="col">P85<text class="th-sub">中上</text></view>
        <view class="col">P97<text class="th-sub">偏高</text></view>
      </view>
      <view wx:for="{{rows}}" wx:key="ageYears" class="std-row {{item.isTarget ? 'target' : ''}}">
        <view class="col age">{{item.label}}</view>
        <view class="col {{item.hl.p3 ? 'hl' : ''}}">{{item.p3}}</view>
        <view class="col {{item.hl.p15 ? 'hl' : ''}}">{{item.p15}}</view>
        <view class="col {{item.hl.p50 ? 'hl' : ''}}">{{item.p50}}</view>
        <view class="col {{item.hl.p85 ? 'hl' : ''}}">{{item.p85}}</view>
        <view class="col {{item.hl.p97 ? 'hl' : ''}}">{{item.p97}}</view>
      </view>
    </view>
    <view class="unit-note">单位：{{unit}}</view>
  </view>

  <view class="note-card">
    <text class="note-title">怎么看这张表</text>
    <text class="note-text">百分位表示"同龄同性别孩子中，百分之多少低于这个值"。P50 是中位数，P3–P97 是常见参考区间，多数孩子落在这里；低于 P3 或高于 P97 建议找专业评估。</text>
  </view>
  <view class="note-card">
    <text class="note-title">参考依据</text>
    <text class="note-text">WHO 儿童生长标准：2006 年发布 0–5 岁，2007 年扩展至 5–19 岁（身高 / 体重 / BMI 按年龄与性别的百分位与 Z 值）。</text>
  </view>
  <view class="note-card">
    <text class="note-title">使用提醒</text>
    <text class="note-text">当前数值为开发期示意数据，正式版以 WHO 官方 LMS 数据为准。生长记录仅供日常参考，明显偏离或家长有疑虑时建议到儿童保健科做专业评估。</text>
  </view>
</view>
