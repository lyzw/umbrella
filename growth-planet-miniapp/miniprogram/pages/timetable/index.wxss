.week-nav {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
}
.week-nav-day {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 0 6px;
  border-radius: var(--radius-md);
  background: #fff;
  border: 1px solid var(--line);
}
.week-nav-day.on {
  background: var(--primary-soft);
  border-color: var(--primary);
}
.week-nav-day.today .week-nav-label { font-weight: 800; color: var(--primary); }
.week-nav-label { font-size: 14px; color: #344054; line-height: 1; }
.week-nav-dot { width: 5px; height: 5px; border-radius: 50%; background: #d0d4dc; }
.week-nav-day.on .week-nav-dot { background: var(--primary); }

.day-banner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 2px 2px 10px;
}
.day-banner-name { font-size: 15px; font-weight: 800; color: #172033; }
.day-banner-count { font-size: 12px; color: var(--muted); }

.period-list { display: flex; flex-direction: column; gap: 8px; }
.period-row { display: flex; gap: 10px; align-items: center; }
.period-no {
  width: 34px;
  min-width: 34px;
  font-size: 11px;
  color: var(--muted);
  text-align: right;
}
.period-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 14px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}
.period-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.period-name { font-size: 14px; font-weight: 800; color: #172033; overflow-wrap: anywhere; }
.period-meta { font-size: 11px; color: var(--muted); }
.period-dot { width: 9px; height: 9px; min-width: 9px; border-radius: 50%; }

.lunch-break {
  padding: 4px 0;
  text-align: center;
  font-size: 11px;
  color: var(--muted);
}

.homework-entry { margin-top: 18px; }
.footnote { margin-top: 10px; text-align: center; font-size: 11px; color: var(--muted); }
