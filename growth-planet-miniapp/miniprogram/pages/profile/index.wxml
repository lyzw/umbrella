<view class="page {{role === 'PARENT' ? 'parent' : ''}}">
  <page-back role="{{role}}" fallback-tab="me" disabled="{{busy}}" />
  <view class="title">{{role === 'PARENT' ? '儿童档案' : '我的口味偏好'}}</view>
  <view class="subtitle">过敏信息仅由家长维护，偏好不会替代过敏防护。</view>
  <picker wx:if="{{role === 'PARENT' && children.length}}" range="{{children}}" range-key="displayName" value="{{childIndex}}" bindchange="child" disabled="{{busy}}"><view class="picker">当前儿童 · {{children[childIndex].displayName}}</view></picker>
  <view wx:if="{{ready}}" class="section">
    <view wx:if="{{role === 'PARENT'}}">
      <view class="field"><text class="label">昵称</text><input value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="64" /></view>
      <view class="field"><text class="label">年级</text><picker range="{{grades}}" bindchange="grade"><view class="picker">{{grade}}</view></picker></view>
      <view class="field"><text class="label">学校</text><picker range="{{schoolOptions}}" bindchange="school"><view class="picker">{{school}}</view></picker></view>
      <view class="field"><text class="label">过敏原编码（合成开发目录）</text><checkbox-group bindchange="allergies"><label wx:for="{{allergyOptions}}" wx:key="code" class="check"><checkbox value="{{item.code}}" checked="{{item.checked}}" />{{item.code}}</label></checkbox-group></view>
    </view>
    <view class="field"><text class="label">不喜欢的食物（逗号分隔）</text><textarea value="{{dislikesText}}" data-field="dislikesText" bindinput="input" maxlength="1299" /></view>
    <view class="field"><text class="label">口味偏好（逗号分隔）</text><textarea value="{{tastesText}}" data-field="tastesText" bindinput="input" maxlength="1299" /></view>
    <button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{!ready}}" bindtap="load" disabled="{{busy}}">重新检查授权</button>
</view>
