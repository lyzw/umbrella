<view class="page {{role === 'PARENT' ? 'parent' : ''}}">
  <view class="title">{{role === 'PARENT' ? '儿童档案' : '我的信息'}}</view>
  <view class="subtitle">{{role === 'PARENT' ? '档案信息与儿童相关的功能，都在这里集中管理' : '自己的档案只读展示，想改先点下方按钮'}}</view>
  <picker wx:if="{{role === 'PARENT' && children.length}}" range="{{children}}" range-key="displayName" value="{{childIndex}}" bindchange="child" disabled="{{busy}}"><view class="picker">当前儿童 · {{children[childIndex].displayName}}</view></picker>

  <!-- 显示模式：档案信息 + 相关功能入口 -->
  <view wx:if="{{ready && viewMode === 'view'}}" class="section profile-view">
    <view class="profile-head">
      <view class="avatar">{{nicknameChar}}</view>
      <view class="profile-copy">
        <view class="profile-name">{{nickname || '未设置昵称'}}</view>
        <view class="profile-meta" wx:if="{{role === 'PARENT'}}">{{grade || '未设置年级'}}<text wx:if="{{school}}"> · {{school}}</text></view>
        <view class="profile-birth" wx:if="{{role === 'PARENT'}}">出生年月：{{birthLabel || '未填写'}}<text wx:if="{{ageYears}}"> · {{ageYears}}岁</text></view>
      </view>
    </view>

    <view class="tag-group" wx:if="{{allergies.length}}">
      <text class="tag-label">过敏原</text>
      <view class="tag-row">
        <text wx:for="{{allergies}}" wx:key="*this" class="tag allergen">{{item}}</text>
      </view>
    </view>
    <view class="tag-group" wx:if="{{dislikes.length}}">
      <text class="tag-label">不喜欢的食物</text>
      <view class="tag-row">
        <text wx:for="{{dislikes}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>
    <view class="tag-group" wx:if="{{tastes.length}}">
      <text class="tag-label">口味偏好</text>
      <view class="tag-row">
        <text wx:for="{{tastes}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!allergies.length && !dislikes.length && !tastes.length}}">还没有填写档案信息，点击下方按钮补充。</view>

    <button class="primary" bindtap="edit">{{role === 'PARENT' ? '编辑档案' : '编辑口味偏好'}}</button>
  </view>

  <!-- 编辑模式：保持原有表单 -->
  <view wx:if="{{ready && viewMode === 'edit'}}" class="section">
    <view wx:if="{{role === 'PARENT'}}">
      <view class="field"><text class="label">昵称</text><input value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="64" /></view>
      <view class="field"><text class="label">年级</text><picker range="{{grades}}" bindchange="grade"><view class="picker">{{grade}}</view></picker></view>
      <view class="field"><text class="label">学校</text><picker range="{{schoolOptions}}" bindchange="school"><view class="picker">{{school}}</view></picker></view>
      <view class="field"><text class="label">出生年月</text><picker mode="date" fields="month" start="2000-01" end="{{todayMonth}}" bindchange="birth"><view class="picker {{birthLabel ? '' : 'placeholder'}}">{{birthLabel || '请选择出生年月'}}</view></picker></view>
      <view class="field"><text class="label">过敏原编码（合成开发目录）</text><checkbox-group bindchange="allergies"><label wx:for="{{allergyOptions}}" wx:key="code" class="check"><checkbox value="{{item.code}}" checked="{{item.checked}}" />{{item.code}}</label></checkbox-group></view>
    </view>
    <view class="field">
      <text class="label">不喜欢的食物</text>
      <view wx:if="{{dislikes.length}}" class="preference-chips">
        <view wx:for="{{dislikes}}" wx:key="*this" class="preference-chip">
          <text class="preference-chip-text">{{item}}</text>
          <button class="preference-remove" bindtap="removePreference" data-field="dislikes" data-index="{{index}}" aria-label="删除{{item}}">×</button>
        </view>
      </view>
      <view class="preference-entry">
        <input value="{{dislikesText}}" data-field="dislikesText" bindinput="input" bindconfirm="addPreference" confirm-type="done" maxlength="1299" placeholder="输入食物名称，可用逗号分隔" />
        <button class="preference-add" bindtap="addPreference" data-field="dislikesText" disabled="{{busy}}">添加</button>
      </view>
    </view>
    <view class="field">
      <text class="label">口味偏好</text>
      <view wx:if="{{tastes.length}}" class="preference-chips">
        <view wx:for="{{tastes}}" wx:key="*this" class="preference-chip">
          <text class="preference-chip-text">{{item}}</text>
          <button class="preference-remove" bindtap="removePreference" data-field="tastes" data-index="{{index}}" aria-label="删除{{item}}">×</button>
        </view>
      </view>
      <view class="preference-entry">
        <input value="{{tastesText}}" data-field="tastesText" bindinput="input" bindconfirm="addPreference" confirm-type="done" maxlength="1299" placeholder="输入口味名称，可用逗号分隔" />
        <button class="preference-add" bindtap="addPreference" data-field="tastesText" disabled="{{busy}}">添加</button>
      </view>
    </view>
    <view class="actions">
      <button bindtap="cancelEdit">取消</button>
      <button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存</button>
    </view>
  </view>

  <!-- 儿童相关信息聚合入口 -->
  <view wx:if="{{ready && viewMode === 'view'}}" class="section links">
    <view class="section-title">儿童相关信息</view>
    <view class="link-row" bindtap="openGrowth">
      <view class="link-copy"><text class="link-name">成长记录</text><text class="link-desc">身高体重、生长曲线与 WHO 标准</text></view>
      <text class="link-arrow">›</text>
    </view>
    <view class="link-row" bindtap="openHealth">
      <view class="link-copy"><text class="link-name">健康打卡</text><text class="link-desc">喝水、睡眠、运动等习惯打卡</text></view>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{!ready}}" bindtap="load" disabled="{{busy}}">重新检查授权</button>
</view>
