/* 偏好 / 档案表单分区统一为卡片表面 */
.section {
  border-top: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: var(--shadow-soft);
}
/* 表单分区之间留出呼吸感 */
.field { margin-bottom: 16px; }
/* 保存 / 主操作按钮在卡片内占满宽度，便于儿童或家长单手操作 */
.section button.primary { width: 100%; }
.actions { margin-top: 16px; }
.preference-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 10px; }
.preference-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 36px;
  padding-left: 12px;
  border: 1px solid var(--primary-border);
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary-ink);
}
.preference-chip-text { max-width: 220px; overflow-wrap: anywhere; font-size: 13px; font-weight: 700; }
button.preference-remove {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--primary-ink);
  font-size: 20px;
  line-height: 44px;
  font-weight: 500;
}
.preference-entry { display: flex; align-items: center; gap: 8px; }
.preference-entry input { flex: 1; min-width: 0; }
button.preference-add {
  flex: 0 0 auto;
  min-width: 64px;
  min-height: 48px;
  padding: 10px 12px;
  background: var(--surface-2);
  color: var(--primary-ink);
  font-size: 14px;
  box-shadow: none;
}

/* ===== 显示模式：档案信息卡 ===== */
.profile-view { padding: 18px 16px; }
.profile-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.avatar { width: 52px; height: 52px; border-radius: 16px; background: var(--primary-soft); color: var(--primary); font-size: 22px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex: none; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 18px; font-weight: 800; color: #172033; }
.profile-meta { font-size: 13px; color: var(--muted); margin-top: 3px; }
.tag-group { margin-top: 12px; }
.tag-label { font-size: 12px; color: var(--muted); display: block; margin-bottom: 6px; }
.tag-row { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--primary-soft); color: var(--primary-ink); }
.tag.allergen { background: #fdecec; color: #c0392b; }

/* ===== 儿童相关信息入口 ===== */
.links { padding: 14px 16px; }
.links .section-title { margin-bottom: 4px; }
.link-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 13px 0; border-bottom: 1px solid #f0f1f4; }
.link-row:last-child { border-bottom: 0; }
.link-copy { flex: 1; min-width: 0; }
.link-name { display: block; font-size: 15px; font-weight: 800; color: #172033; }
.link-desc { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }
.link-arrow { font-size: 16px; color: var(--muted); flex: none; }

.picker.placeholder { color: #b3bac4; }
