/* 偏好 / 档案表单分区统一为卡片表面 */
.section {
  border-top: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: var(--shadow-soft);
}
/* 表单分区之间留出呼吸感 */
.field { margin-bottom: 16px; }
/* 保存 / 主操作按钮在卡片内占满宽度，便于儿童或家长单手操作 */
.section button.primary { width: 100%; }
.actions { margin-top: 16px; }
.preference-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 10px; }
.preference-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 36px;
  padding-left: 12px;
  border: 1px solid var(--primary-border);
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary-ink);
}
.preference-chip-text { max-width: 220px; overflow-wrap: anywhere; font-size: 13px; font-weight: 700; }
button.preference-remove {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--primary-ink);
  font-size: 20px;
  line-height: 44px;
  font-weight: 500;
}
.preference-entry { display: flex; align-items: center; gap: 8px; }
.preference-entry input { flex: 1; min-width: 0; }
button.preference-add {
  flex: 0 0 auto;
  min-width: 64px;
  min-height: 48px;
  padding: 10px 12px;
  background: var(--surface-2);
  color: var(--primary-ink);
  font-size: 14px;
  box-shadow: none;
}
