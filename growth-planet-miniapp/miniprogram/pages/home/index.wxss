.home-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
.notification-button { position: relative; width: 48px; min-width: 48px; height: 48px; padding: 0; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(20, 40, 80, .06), 0 6px 18px rgba(20, 40, 80, .06); }
.notification-icon { font-size: 20px; line-height: 48px; }
.notification-badge { position: absolute; top: -3px; right: -3px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px; background: #c62828; color: #fff; font-size: 11px; line-height: 18px; text-align: center; }
.environment-chip { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 10px; margin: -8px 0 14px; border-radius: 8px; background: #fffbeb; color: #92400e; font-size: 12px; font-weight: 600; }
.hero-panel { position: relative; overflow: hidden; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: var(--radius-xl); padding: 22px 20px 18px; margin-bottom: 14px; box-shadow: var(--shadow-soft); }
.hero-copy { position: relative; z-index: 1; padding-right: 86px; }
.hero-kicker { color: var(--primary); font-size: 12px; font-weight: 700; margin-bottom: 6px; }
.hero-title { font-size: 22px; line-height: 1.4; font-weight: 800; }
.hero-description { color: #5b6776; font-size: 14px; line-height: 1.65; margin-top: 8px; }
.hero-visual { position: absolute; right: 16px; top: 26px; width: 64px; height: 64px; border-radius: 18px; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 8px 20px rgba(20, 40, 80, .08); }
.hero-action { width: 100%; margin-top: 18px; }
.home-list { overflow: hidden; background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); }
.home-list-row { width: 100%; min-height: 70px; padding: 11px 14px; background: #fff; border-radius: 0; border-bottom: 1px solid #e6ebf2; display: flex; align-items: center; gap: 12px; text-align: left; }
.home-list-row:last-child { border-bottom: 0; }
.home-list-icon { width: 42px; min-width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 800; }
.confirmation-icon { color: #15803d; background: #dcfce7; }
.wallet-icon { color: #b45309; background: #fef3c7; }
.family-icon { color: #15803d; background: #dcfce7; }
.profile-icon { color: #1d4ed8; background: #dbeafe; }
.notice-icon { color: #6d28d9; background: #ede9fe; }
.privacy-icon { color: #475569; background: #f1f5f9; }
.dish-icon { color: #b03a1c; background: #fff1e9; }
.schedule-icon { color: #2563eb; background: #dbeafe; }
.home-list-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.home-list-title { color: #1f2733; font-size: 15px; line-height: 22px; font-weight: 700; }
.home-list-subtitle { color: #687386; font-size: 12px; line-height: 19px; }
.home-list-arrow { color: #64748b; font-size: 24px; font-weight: 400; }
.row-badge { min-width: 24px; height: 24px; padding: 0 7px; border-radius: 12px; background: var(--primary-soft); color: var(--primary); font-size: 12px; line-height: 24px; text-align: center; }
.empty-state, .growth-panel { background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-xl); padding: 48px 22px; text-align: center; box-shadow: var(--shadow-soft); }
.empty-icon { width: 72px; height: 72px; margin: 0 auto 18px; border-radius: 20px; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; }
.growth-panel { background: #f0fdf4; border-color: #bbf7d0; }
.seedling { position: relative; height: 150px; width: 150px; margin: 0 auto 18px; }
.stem { position: absolute; background: #23844f; height: 88px; width: 7px; left: 72px; top: 42px; border-radius: 4px; }
.leaf { position: absolute; width: 54px; height: 34px; background: #57a973; top: 34px; z-index: 1; }
.left { left: 23px; border-radius: 0 30px 0 30px; transform: rotate(12deg); }
.right { left: 74px; top: 20px; border-radius: 30px 0 30px 0; transform: rotate(-12deg); }
.soil { position: absolute; left: 29px; bottom: 10px; width: 92px; height: 20px; border-radius: 50%; background: #bbf7d0; }
.growth-status { display: inline-flex; align-items: center; min-height: 30px; margin-top: 18px; padding: 4px 10px; border-radius: 8px; background: #fff; color: #15803d; font-size: 12px; font-weight: 700; }
.profile-summary { display: flex; align-items: center; gap: 12px; padding: 16px; margin-bottom: 14px; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: 16px; }
.profile-avatar { width: 54px; min-width: 54px; height: 54px; border-radius: 50%; background: #fff; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; }
.profile-title { font-size: 17px; font-weight: 700; margin-bottom: 3px; }
.profile-badge { margin-left: auto; padding: 3px 8px; border-radius: 8px; background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 700; }
.logout-button { width: 100%; margin-top: 18px; background: #fef2f2; color: #b91c1c; }
@media (max-width: 340px) {
  .hero-copy { padding-right: 0; }
  .hero-visual { position: static; margin-top: 14px; }
}
