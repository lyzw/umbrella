.home-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
.notification-button { position: relative; flex: 0 0 48px; width: 48px; min-width: 48px; height: 48px; min-height: 48px; padding: 0; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(20, 40, 80, .06), 0 6px 18px rgba(20, 40, 80, .06); }
.notification-icon { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #334155; font-size: 16px; line-height: 1; font-weight: 800; }
.notification-badge { position: absolute; top: 3px; right: 3px; min-width: 18px; height: 18px; padding: 0 4px; box-sizing: border-box; border-radius: 9px; background: #c62828; color: #fff; font-size: 11px; line-height: 18px; text-align: center; white-space: nowrap; }
.environment-chip { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 10px; margin: -8px 0 14px; border-radius: 8px; background: #fffbeb; color: #92400e; font-size: 12px; font-weight: 600; }
.hero-panel { position: relative; overflow: hidden; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: var(--radius-xl); padding: 22px 20px 18px; margin-bottom: 14px; box-shadow: var(--shadow-soft); }
.hero-copy { position: relative; z-index: 1; padding-right: 86px; }
.hero-kicker { color: var(--primary); font-size: 12px; font-weight: 700; margin-bottom: 6px; }
.hero-title { font-size: 22px; line-height: 1.4; font-weight: 800; }
.hero-description { color: #5b6776; font-size: 14px; line-height: 1.65; margin-top: 8px; }
.hero-visual { position: absolute; right: 16px; top: 26px; width: 64px; height: 64px; border-radius: 18px; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 8px 20px rgba(20, 40, 80, .08); }
.hero-action { width: 100%; margin-top: 18px; }
.home-list { overflow: hidden; background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); }
.home-list-row { width: 100%; min-height: 70px; padding: 11px 14px; background: #fff; border-radius: 0; border-bottom: 1px solid #e6ebf2; display: block; text-align: left; transition: background-color .12s ease, transform .12s ease; }
.home-list-row:last-child { border-bottom: 0; }
.home-list-row-active { background: #f7f9fc; transform: scale(.995); }
.home-list-row-content { width: 100%; min-height: 48px; display: flex; align-items: center; justify-content: flex-start; gap: 12px; }
.home-list-icon { width: 42px; min-width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 800; }
.confirmation-icon { color: #15803d; background: #dcfce7; }
.wallet-icon { color: #b45309; background: #fef3c7; }
.family-icon { color: #15803d; background: #dcfce7; }
.profile-icon { color: #1d4ed8; background: #dbeafe; }
.notice-icon { color: #6d28d9; background: #ede9fe; }
.privacy-icon { color: #475569; background: #f1f5f9; }
.dish-icon { color: #b03a1c; background: #fff1e9; }
.schedule-icon { color: #2563eb; background: #dbeafe; }
.medal-icon { color: #8a6400; background: var(--c-medal-soft); }
.health-icon { color: #b03a68; background: var(--c-health-soft); }
.parent-summary { margin-bottom: 14px; padding: 16px 0; }
.parent-summary-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.parent-child-picker { max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.parent-child-label { max-width: 180px; overflow-wrap: anywhere; text-align: right; }
.parent-summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 14px; border-top: 1px solid #e6ebf2; }
.parent-summary-item { min-width: 0; padding: 14px 8px 4px; text-align: center; border-right: 1px solid #e6ebf2; }
.parent-summary-item:last-child { border-right: 0; }
.parent-summary-value { display: block; min-height: 28px; overflow-wrap: anywhere; color: #1f2733; font-size: 24px; line-height: 1.1; font-weight: 800; }
.parent-summary-value.summary-loading { color: #94a3b8; }
.parent-summary-value.summary-error { color: #b91c1c; }
.parent-summary-label { display: block; margin-top: 5px; color: #334155; font-size: 12px; font-weight: 700; overflow-wrap: anywhere; }
.parent-summary-hint { display: block; min-height: 17px; margin-top: 3px; color: #687386; font-size: 10px; line-height: 17px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.parent-summary-empty { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px solid #e6ebf2; color: #687386; font-size: 12px; }
.parent-summary-empty button { flex: 0 0 auto; min-height: 38px; }
.parent-summary-retry { width: 100%; min-height: 38px; margin-top: 12px; }
.home-list-copy { flex: 1; width: 0; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
.home-list-title { color: #1f2733; font-size: 15px; line-height: 22px; font-weight: 700; }
.home-list-subtitle { color: #687386; font-size: 12px; line-height: 19px; }
.home-list-arrow { flex: 0 0 24px; margin-left: auto; color: #64748b; font-size: 24px; font-weight: 400; text-align: right; }
.row-badge { flex: 0 0 auto; margin-left: auto; min-width: 24px; height: 24px; padding: 0 7px; border-radius: 12px; background: var(--primary-soft); color: var(--primary); font-size: 12px; line-height: 24px; text-align: center; }
.empty-state, .growth-panel { background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-xl); padding: 48px 22px; text-align: center; box-shadow: var(--shadow-soft); }
.empty-icon { width: 72px; height: 72px; margin: 0 auto 18px; border-radius: 20px; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; }
.growth-panel { background: #f0fdf4; border-color: #bbf7d0; }
.seedling { position: relative; height: 150px; width: 150px; margin: 0 auto 18px; }
.stem { position: absolute; background: #23844f; height: 88px; width: 7px; left: 72px; top: 42px; border-radius: 4px; }
.leaf { position: absolute; width: 54px; height: 34px; background: #57a973; top: 34px; z-index: 1; }
.left { left: 23px; border-radius: 0 30px 0 30px; transform: rotate(12deg); }
.right { left: 74px; top: 20px; border-radius: 30px 0 30px 0; transform: rotate(-12deg); }
.soil { position: absolute; left: 29px; bottom: 10px; width: 92px; height: 20px; border-radius: 50%; background: #bbf7d0; }
.growth-action { width: 100%; margin-top: 22px; }
.profile-summary { display: flex; align-items: center; gap: 12px; padding: 16px; margin-bottom: 14px; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: 16px; }
.profile-avatar { width: 54px; min-width: 54px; height: 54px; border-radius: 50%; background: #fff; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; }
.profile-title { font-size: 17px; font-weight: 700; margin-bottom: 3px; }
.profile-badge { margin-left: auto; padding: 3px 8px; border-radius: 8px; background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 700; }
.logout-button { width: 100%; margin-top: 18px; background: #fef2f2; color: #b91c1c; }
.child-progress { display: flex; gap: 8px; margin-bottom: 12px; }
.child-progress-chip { padding: 5px 12px; border-radius: 999px; background: var(--primary-soft); color: var(--primary); font-size: 13px; font-weight: 700; }
.meal-summary { display: flex; align-items: stretch; gap: 0; padding: 4px 0 12px; margin-bottom: 14px; border-bottom: 1px solid #e6ebf2; }
.meal-summary-col { display: flex; flex: 1 1 0; flex-direction: column; align-items: center; justify-content: center; min-width: 0; padding: 8px 6px; }
.meal-summary-col-active { background: #f7f9fc; border-radius: 10px; }
.meal-summary-num { font-size: 26px; font-weight: 800; color: #1f2733; line-height: 1.1; }
.meal-summary-label { max-width: 100%; margin-top: 2px; color: #687386; font-size: 12px; line-height: 18px; white-space: nowrap; }
.meal-summary-divider { width: 1px; height: 36px; background: #e6ebf2; }
.quick-scroll { white-space: nowrap; margin-bottom: 6px; }
.quick-card { display: inline-flex; flex-direction: column; width: 132px; margin-right: 10px; padding: 14px 12px; background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; box-shadow: var(--shadow-soft); vertical-align: top; }
.quick-card-active { transform: scale(.97); background: #f7f9fc; }
.quick-card-emoji { font-size: 26px; }
.quick-card-name { font-size: 15px; font-weight: 700; color: #1f2733; margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 108px; }
.quick-card-reason { font-size: 11px; color: #687386; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 108px; }
.quick-card-tag { margin-top: 8px; font-size: 11px; font-weight: 700; color: var(--primary); }
.wish-card { padding: 14px 16px; margin-bottom: 12px; background: linear-gradient(135deg, #fff7e6, #fff); border: 1px solid #fde68a; border-radius: 16px; }
.wish-card-head { display: flex; align-items: center; justify-content: space-between; }
.wish-card-title { font-size: 15px; font-weight: 700; color: #92400e; }
.wish-card-count { font-size: 13px; font-weight: 800; color: #b45309; }
.wish-card-sub { display: block; font-size: 12px; color: #92400e; margin-top: 4px; }
.confirm-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; margin-bottom: 12px; background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; box-shadow: var(--shadow-soft); }
.confirm-bar.warn { border-color: #fde68a; background: #fffbeb; }
.confirm-bar.ok { border-color: #bbf7d0; background: #f0fdf4; }
.confirm-bar.err { border-color: #fecaca; background: #fef2f2; }
.confirm-bar-text { font-size: 13px; font-weight: 700; color: #1f2733; }
.growth-panel { background: #fff; border: 1px solid #e6ebf2; border-radius: var(--radius-xl); padding: 20px 18px; box-shadow: var(--shadow-soft); }
.growth-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.growth-head-title { font-size: 18px; font-weight: 800; }
.growth-streak { font-size: 13px; font-weight: 700; color: #b45309; }
.balance-card { padding: 16px; margin-bottom: 16px; background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: 16px; }
.balance-card .label { font-size: 12px; color: var(--primary); font-weight: 700; }
.balance-card .amount { font-size: 30px; font-weight: 800; color: #1f2733; margin: 4px 0; }
.balance-card .unit { font-size: 13px; font-weight: 600; color: #687386; margin-left: 6px; }
.balance-card .small { font-size: 11px; color: #687386; }
.medal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
.medal { padding: 12px 8px; border-radius: 14px; text-align: center; background: #f7f9fc; border: 1px solid #e6ebf2; }
.medal.on { background: var(--c-medal-soft); border-color: #fcd34d; }
.medal .icon { font-size: 28px; }
.medal-name { font-size: 12px; font-weight: 700; margin-top: 4px; color: #1f2733; }
.medal-state { font-size: 10px; color: #687386; margin-top: 2px; }
@media (max-width: 340px) {
  .hero-copy { padding-right: 0; }
  .hero-visual { position: static; margin-top: 14px; }
}
