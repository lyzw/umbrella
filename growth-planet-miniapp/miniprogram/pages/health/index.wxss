.page-heading { margin-bottom: 18px; }
.page-heading .subtitle { display: block; margin-bottom: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.compact-action { flex: 0 0 auto; }
.form-panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-bottom: 22px;
  box-shadow: var(--shadow-soft);
}
.form-panel > input { margin-bottom: 12px; }
.form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .7fr); gap: 12px; margin-bottom: 12px; }
.form-row picker { min-width: 0; }
.form-row input { min-width: 0; }
.form-actions { display: flex; gap: 12px; margin-top: 16px; }
.form-actions button { flex: 1; min-width: 0; }
.list-title { margin-top: 24px; }
.item-title { min-width: 0; font-size: 16px; font-weight: 800; line-height: 1.45; overflow-wrap: anywhere; }
.item-action { width: 100%; margin-top: 16px; }
.badge.normal { color: var(--muted); background: var(--surface-2); }
.badge.ok { color: #08764e; background: var(--positive-soft); }
/* 预设快捷创建：chip 为多行换行布局，点击区保持 ≥44px */
.preset-hint { display: block; margin-bottom: 8px; }
.preset-row { display: flex; flex-wrap: wrap; margin: 0 0 14px; }
.preset-row .chip { min-height: 44px; }

/* 儿童端：连续打卡剂量卡 */
.streak-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px;
  margin-bottom: 4px;
  background: var(--c-health-soft);
  border: 1px solid #ffd3e4;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
}
.streak-copy { display: flex; flex-direction: column; gap: 4px; }
.streak-label { color: #b03a68; font-size: 12px; font-weight: 700; }
.streak-value { color: #a82f5e; font-size: 34px; font-weight: 800; line-height: 1.2; font-variant-numeric: tabular-nums; }
.streak-unit { margin-left: 4px; font-size: 14px; font-weight: 600; }
.streak-visual {
  width: 64px;
  min-width: 64px;
  height: 64px;
  border-radius: 18px;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  box-shadow: 0 8px 20px rgba(20, 40, 80, .08);
}

/* 儿童端：打卡日历 */
.month-toolbar .month-label { flex: 1; text-align: center; font-size: 16px; font-weight: 800; }
.calendar {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 14px;
  box-shadow: var(--shadow-soft);
}
.calendar-head, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
.calendar-week { text-align: center; font-size: 12px; font-weight: 700; color: var(--muted); }
.calendar-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  border-radius: 10px;
  background: var(--surface-2);
  color: #344054;
  font-size: 14px;
  font-variant-numeric: tabular-nums;
}
.calendar-cell.pad { background: transparent; }
.calendar-cell.future { background: transparent; color: #b6bfcc; }
.calendar-cell.checked { background: var(--c-health); color: #fff; font-weight: 800; }
.calendar-cell.today { outline: 2px solid var(--c-health); outline-offset: -2px; }
.calendar-cell.checked.today { outline-color: #a82f5e; }
.calendar-summary { margin-top: 12px; }

@media (max-width: 420px) {
  .toolbar { align-items: stretch; flex-direction: column; }
  .compact-action { width: 100%; }
  .form-row { grid-template-columns: 1fr; }
  .form-actions { flex-direction: column; }
}

@media (max-width: 360px) {
  .form-panel { padding: 14px; }
}
