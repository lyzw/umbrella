page {
  background: #f7f9fc;
  color: #172033;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 16px;
  letter-spacing: 0;
}
view, button, input, textarea { box-sizing: border-box; }
.page {
  max-width: 760px;
  margin: 0 auto;
  padding: 20px 18px 44px;
  /* 角色化主色（子=蓝，家长=绿，见 .parent 覆盖） */
  --primary: #2878ff;
  --primary-dark: #1859c9;
  --primary-soft: #edf5ff;
  --primary-border: #c9ddff;
  --primary-ink: #154a9e;
  --accent: #ff7657;
  --accent-soft: #fff0eb;
  --positive: #22a06b;
  --positive-soft: #e9f8f1;
  --warning: #e89016;
  --warning-soft: #fff7df;
  --danger: #e5484d;
  --danger-soft: #fff1f0;
  --surface: #fff;
  --surface-2: #f1f5fb;
  --line: #e4e9f1;
  --hairline: #eef2f7;
  --muted: #667085;
  /* 圆角 / 间距 / 阴影 / 动效 统一标尺 */
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --space-1: 8px;
  --space-2: 12px;
  --space-3: 16px;
  --space-4: 22px;
  --shadow-soft: 0 1px 3px rgba(20, 40, 80, .06), 0 6px 18px rgba(20, 40, 80, .06);
  --shadow-strong: 0 10px 30px rgba(20, 40, 80, .14);
  --motion-fast: .14s ease;
  --motion: .2s ease;
  --shadow: 0 10px 28px rgba(32, 55, 92, .08);
  /* V0.0.2 分类语义色：流水分类标签、预算占比图与模块入口底色共用 */
  --c-meal: #ff7657;
  --c-meal-soft: #fff0eb;
  --c-chore: #22a06b;
  --c-chore-soft: #e9f8f1;
  --c-shop: #7c5cff;
  --c-shop-soft: #f0edff;
  --c-exchange: #12b5a5;
  --c-exchange-soft: #e6f8f6;
  --c-manual: #2878ff;
  --c-manual-soft: #edf5ff;
  --c-medal: #f5b301;
  --c-medal-soft: #fff8e0;
}
.parent {
  --primary: #15966a;
  --primary-dark: #0e704e;
  --primary-soft: #ebf9f3;
  --primary-border: #bce9d6;
  --primary-ink: #0b6848;
}
.with-nav { padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; gap: 14px; }
.title { font-size: 26px; font-weight: 800; line-height: 1.3; overflow-wrap: anywhere; }
.subtitle { color: var(--muted); line-height: 1.7; margin: 8px 0 20px; font-size: 14px; }
.eyebrow { font-size: 12px; color: var(--primary); font-weight: 700; margin-bottom: 5px; }
.section { padding: 22px 0; border-top: 1px solid var(--line); }
.section:first-child { border-top: 0; }
.section-title { font-size: 18px; font-weight: 800; line-height: 1.45; margin-bottom: 12px; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.stack > view, .stack > button { margin-bottom: 12px; }
.muted { color: var(--muted); font-size: 14px; line-height: 1.65; }
.small { font-size: 12px; color: var(--muted); line-height: 1.5; }
.amount { font-size: 34px; font-weight: 800; color: var(--primary); font-variant-numeric: tabular-nums; }
.unit { font-size: 14px; font-weight: normal; color: var(--muted); margin-left: 6px; }
button {
  min-height: 46px;
  margin: 0;
  padding: 11px 17px;
  font-size: 16px;
  line-height: 24px;
  border-radius: 10px;
  background: #edf1f6;
  color: #29364a;
  font-weight: 700;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: transform .12s ease, opacity .12s ease, background-color .12s ease;
}
button::after { border: 0; }
button.primary { background: var(--primary); color: #fff; box-shadow: 0 8px 18px rgba(40, 120, 255, .2); }
.parent button.primary { box-shadow: 0 8px 18px rgba(21, 150, 106, .18); }
button.primary:active { background: var(--primary-dark); transform: scale(.98); }
button.danger { background: #fff0f0; color: #b42318; }
button[disabled] { background: #e9edf2; color: #98a2b3; box-shadow: none; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.actions button { flex: 1; min-width: 110px; }
.icon-button { width: 44px; min-width: 44px; height: 44px; padding: 10px; border-radius: 10px; }
.field { margin-bottom: 18px; }
.label { display: block; font-size: 14px; color: #344054; font-weight: 700; margin-bottom: 8px; }
input, textarea, .picker {
  background: var(--surface);
  border: 1px solid #d8dee8;
  border-radius: 10px;
  padding: 12px 14px;
  width: 100%;
  font-size: 16px;
  color: #172033;
  min-height: 48px;
}
input:focus, textarea:focus { border-color: var(--primary); }
input { height: 48px; }
textarea { height: 100px; }
.error {
  background: #fff1f0;
  color: #9d241b;
  padding: 14px 16px;
  margin: 16px 0;
  border: 1px solid #ffc9c5;
  border-left: 4px solid #e5484d;
  border-radius: 10px;
  font-size: 14px;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.notice {
  background: var(--primary-soft);
  color: var(--primary-ink);
  padding: 14px 16px;
  margin: 16px 0;
  font-size: 14px;
  line-height: 1.65;
  border: 1px solid var(--primary-border);
  border-left: 4px solid var(--primary);
  border-radius: 10px;
}
.empty { padding: 52px 14px; text-align: center; color: var(--muted); line-height: 1.8; }
.item {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 17px;
  margin: 12px 0;
  box-shadow: 0 4px 14px rgba(32, 55, 92, .05);
}
.badge {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 3px 9px;
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  margin: 4px 6px 4px 0;
}
.warning { color: #a45a00; background: var(--warning-soft); }
.safe { color: #08764e; background: var(--positive-soft); }
.check { display: flex; align-items: center; min-height: 48px; gap: 8px; font-size: 14px; }
.check .wx-checkbox-input { width: 36rpx; height: 36rpx; }
.tabs { display: flex; gap: 4px; margin: 16px 0; padding: 4px; background: #e9eef5; border-radius: 10px; }
.tabs button { flex: 1; padding: 10px 6px; font-size: 14px; background: transparent; color: var(--muted); }
.tabs .active { background: var(--primary); color: #fff; }
.link-row {
  width: 100%;
  background: var(--surface);
  text-align: left;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  padding: 16px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.loading { color: var(--muted); padding: 22px 0; text-align: center; }
.price { font-size: 20px; font-weight: 800; color: var(--primary); }
.divider { height: 1px; background: var(--line); margin: 20px 0; }
/* 无障碍：键盘/指针聚焦态，保证可读对比与可见焦点 */
input:focus, textarea:focus, .picker:focus, button:focus-visible, .link-row:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
/* 统一卡片浮层与状态容器，复用层级标尺 */
.item {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}
.section { padding: var(--space-4) 0; }
.notice, .error { border-radius: var(--radius-md); }
.empty { padding: 52px 14px; }
/* 标准页头：标题 + 操作按钮的通用栅格 */
.header { align-items: center; }
.header .title { flex: 1; min-width: 0; }
.header button { flex: 0 0 auto; }
/* 状态徽标语义化 */
.badge.positive { color: #08764e; background: var(--positive-soft); }
.badge.danger { color: #9d241b; background: var(--danger-soft); }
/* V0.0.2 分类徽章：与流水 scene 一一对应（点餐/家务奖励/购物/兑换/发放/勋章） */
.badge.b-c { color: #b03a1c; background: var(--c-meal-soft); }
.badge.b-ac { color: #08764e; background: var(--c-chore-soft); }
.badge.b-sh { color: #4a32b5; background: var(--c-shop-soft); }
.badge.b-ex { color: #0a6f65; background: var(--c-exchange-soft); }
.badge.b-po { color: var(--primary-ink); background: var(--c-manual-soft); }
.badge.b-md { color: #8a6400; background: var(--c-medal-soft); }
/* V0.0.2 额度进度条三态：正常 / 接近上限 / 超额；宽度由内联 style 驱动 */
.progress { height: 10px; background: #e9eef5; border-radius: 999px; overflow: hidden; margin: 10px 0 6px; }
.progress > i { display: block; height: 100%; width: 0; background: var(--positive); border-radius: 999px; transition: width var(--motion); }
.progress.warn > i { background: var(--warning); }
.progress.danger > i { background: var(--danger); }
/* V0.0.2 分段 chip：范围切换（本周/本月、全部/收入/支出） */
.chip { display: inline-flex; align-items: center; justify-content: center; min-height: 34px; padding: 6px 14px;
  margin: 4px 8px 4px 0; background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
  color: var(--muted); font-size: 13px; font-weight: 600; }
.chip.on { background: var(--primary-soft); border-color: var(--primary-border); color: var(--primary-ink); }
/* V0.0.2 图表面板：趋势柱状由 uCharts 绘制，此处仅提供定高容器与空态 */
.chart-box { position: relative; width: 100%; height: 200px; }
.chart-empty { padding: 40px 12px; text-align: center; color: var(--muted); font-size: 13px; line-height: 1.8; }
/* V0.0.2 分类占比条：条宽按占比内联渲染，颜色由分类修饰类决定 */
.cat-item { margin: 12px 0; }
.cat-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; font-size: 14px; }
.cat-bar { height: 8px; margin-top: 6px; background: #e9eef5; border-radius: 999px; overflow: hidden; }
.cat-bar > i { display: block; height: 100%; border-radius: 999px; background: var(--primary); }
.cat-bar > i.b-c { background: var(--c-meal); }
.cat-bar > i.b-ac { background: var(--c-chore); }
.cat-bar > i.b-sh { background: var(--c-shop); }
.cat-bar > i.b-ex { background: var(--c-exchange); }
.cat-bar > i.b-po { background: var(--c-manual); }
/* 尊重系统的减弱动效偏好（WXSS 不支持 * 选择器，逐一列出动效载体） */
@media (prefers-reduced-motion: reduce) {
  page, view, button, input, textarea, text, image,
  .tab, .role-option, .record, .item, .dish {
    animation: none !important;
    transition: none !important;
  }
}
