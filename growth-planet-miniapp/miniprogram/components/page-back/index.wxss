.page-back {
  margin: -8px 0 12px;
}
.page-back-button {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 6px 10px 6px 4px;
  background: transparent;
  color: var(--muted);
  font-size: 14px;
  line-height: 24px;
  box-shadow: none;
}
.page-back-button:active {
  background: var(--surface-2);
}
.page-back-icon {
  margin-right: 3px;
  font-size: 26px;
  line-height: 20px;
}
