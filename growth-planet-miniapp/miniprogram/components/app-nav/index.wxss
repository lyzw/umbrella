.nav {
  --primary: #2878ff;
  --primary-soft: #edf5ff;
  --primary-shadow: rgba(40, 120, 255, .22);
  --primary-press: rgba(40, 120, 255, .06);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(255, 255, 255, .97);
  border-top: 1px solid #e4e9f1;
  box-shadow: 0 -8px 24px rgba(32, 55, 92, .07);
  padding: 7px 10px calc(7px + env(safe-area-inset-bottom));
  z-index: 10;
}
.tab {
  flex: 1;
  min-width: 0;
  min-height: 58px;
  padding: 5px 2px;
  background: transparent;
  border-radius: 14px;
  color: #7a8495;
  margin: 0 1px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background-color .14s ease, color .14s ease;
}
.tab::after { border: 0; }
.tab:active { background: var(--primary-press); }
.tab-icon {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 30px;
  font-size: 14px;
  font-weight: 800;
  background: #eef2f7;
  color: #7a8495;
  transition: background-color .14s ease, color .14s ease, box-shadow .14s ease;
}
.tab-label { height: 18px; line-height: 18px; font-size: 11px; font-weight: 600; margin-top: 3px; }
.active { color: var(--primary); background: var(--primary-soft); }
.active .tab-icon { background: var(--primary); color: #fff; box-shadow: 0 4px 10px var(--primary-shadow); }
.active .tab-label { font-weight: 800; }
.nav.parent {
  --primary: #15966a;
  --primary-soft: #ebf9f3;
  --primary-shadow: rgba(21, 150, 106, .2);
  --primary-press: rgba(21, 150, 106, .06);
}
